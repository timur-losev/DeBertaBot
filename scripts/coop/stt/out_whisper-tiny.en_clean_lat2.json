{"summary": {"engine": "whisper-tiny.en", "cond": "clean", "n": 60, "load_s": 0.5342356000328436, "rss_mb": 222.1015625, "peak_mb": 289.99609375, "cores_busy": 2.383860419884499, "audio_s_avg": 2.3366854166666666, "full_ms_med": 164.22179999062791, "full_ms_p95": 222.90504499105734, "tail_ms_med": null, "tail_ms_p95": null, "rtf_streamed": null, "same_text_streamed": null, "threads": "2"}, "rows": [{"id": "r6_000", "text": "Clip onto the roof edge and go invert it on bedroom.", "full_ms": 222.16579999076203, "audio_s": 3.13}, {"id": "r6_001", "text": "Go white and hit them off their side while I bait front.", "full_ms": 220.29859997564927, "audio_s": 3.07}, {"id": "r6_002", "text": "What up are you even running?", "full_ms": 146.05959999607876, "audio_s": 1.970625}, {"id": "r6_003", "text": "Drone the other room first.", "full_ms": 138.45410000067204, "audio_s": 2.075}, {"id": "r6_004", "text": "Split the angles, I take hatch, you take the other one.", "full_ms": 250.52709999727085, "audio_s": 4.055}, {"id": "r6_005", "text": "Get on the rope and climb up to roof.", "full_ms": 179.63969998527318, "audio_s": 2.36675}, {"id": "r6_006", "text": "On my mark, drop down the rope.", "full_ms": 176.45860003540292, "audio_s": 2.606875}, {"id": "r6_007", "text": "block their sighty line with a smoke", "full_ms": 163.50049996981397, "audio_s": 2.4}, {"id": "r6_008", "text": "hop on the bomb and stick the diffuse.", "full_ms": 171.84950003866106, "audio_s": 2.433875}, {"id": "r6_009", "text": "Bro how did he hear me through the floor?", "full_ms": 179.9275999655947, "audio_s": 2.465}, {"id": "r6_010", "text": "Disengage and Reset.", "full_ms": 134.98259999323636, "audio_s": 1.875}, {"id": "r6_011", "text": "Take the long way through my ping and pinch them.", "full_ms": 193.15679999999702, "audio_s": 2.60475}, {"id": "r6_012", "text": "Come get me, I'm bleeding out.", "full_ms": 173.57649997575209, "audio_s": 2.49}, {"id": "r6_013", "text": "Send it. Send it. Send", "full_ms": 132.10320001235232, "audio_s": 1.265}, {"id": "r6_014", "text": "Smash the glass and jump through.", "full_ms": 151.32649999577552, "audio_s": 2.28075}, {"id": "r6_015", "text": "Get out of there, it's a trap.", "full_ms": 180.41859997902066, "audio_s": 2.475}, {"id": "r6_016", "text": "Pre-aim the window by my ping and don't peek off it.", "full_ms": 236.95069999666885, "audio_s": 3.02}, {"id": "r6_017", "text": "Overwatch me while I'm droning.", "full_ms": 167.53629996674135, "audio_s": 2.177}, {"id": "r6_018", "text": "Throw a stun through the doorway.", "full_ms": 148.6293000052683, "audio_s": 2.095}, {"id": "r6_019", "text": "Slap a charge on the barricade.", "full_ms": 168.69870002847165, "audio_s": 2.25}, {"id": "r6_020", "text": "This map is so bad for attack.", "full_ms": 159.49230000842363, "audio_s": 2.28075}, {"id": "r6_021", "text": "Take the other stairs up.", "full_ms": 135.24760003201663, "audio_s": 1.895}, {"id": "r6_022", "text": "Blow the hatch open.", "full_ms": 123.16740001551807, "audio_s": 1.69}, {"id": "r6_023", "text": "Don't push yet, not ready.", "full_ms": 167.08300000755116, "audio_s": 2.190875}, {"id": "r6_024", "text": "Cook one and toss it in.", "full_ms": 145.86510002845898, "audio_s": 1.95}, {"id": "r6_025", "text": "Roll a Cam into Kitchen and ID the Ops.", "full_ms": 186.57389999134466, "audio_s": 2.72}, {"id": "r6_026", "text": "Res me, please.", "full_ms": 119.74829999962822, "audio_s": 1.56175}, {"id": "r6_027", "text": "Tap the diffuser, I got you.", "full_ms": 173.92650002148002, "audio_s": 2.555}, {"id": "r6_028", "text": "You anchor, freeze where you are.", "full_ms": 164.94310001144186, "audio_s": 2.52}, {"id": "r6_029", "text": "Tell me, we're rushing this together.", "full_ms": 173.78239997196943, "audio_s": 2.5365}, {"id": "r6_030", "text": "Bang the doorway then entry with me.", "full_ms": 162.63650002656505, "audio_s": 2.39}, {"id": "r6_031", "text": "I'm on this angle. You cover whatever I'm not looking at.", "full_ms": 250.7682999712415, "audio_s": 3.625}, {"id": "r6_032", "text": "They rotated through the bedroom wall.", "full_ms": 155.98209999734536, "audio_s": 2.35675}, {"id": "r6_033", "text": "Toss a bang in there.", "full_ms": 140.53309999872, "audio_s": 1.725}, {"id": "r6_034", "text": "Vault into the room off my marker.", "full_ms": 159.50820001307875, "audio_s": 2.265}, {"id": "r6_035", "text": "Cover default plant with smoke. Glaze is watching.", "full_ms": 208.16890004789457, "audio_s": 3.350375}, {"id": "r6_036", "text": "Smoke the doorway.", "full_ms": 112.15070000616834, "audio_s": 1.59}, {"id": "r6_037", "text": "Smoke the second door, not the one I'm hit.", "full_ms": 213.12090003630146, "audio_s": 3.115}, {"id": "r6_038", "text": "Hang on a sec, don't do anything.", "full_ms": 182.0661000092514, "audio_s": 2.532625}, {"id": "r6_039", "text": "Blind the room for me.", "full_ms": 132.0817000232637, "audio_s": 1.741875}, {"id": "r6_040", "text": "Hold main door, anyone swings you drop M.", "full_ms": 197.75430002482608, "audio_s": 3.255}, {"id": "r6_041", "text": "Wait for my call, then smoke the door.", "full_ms": 185.04559999564663, "audio_s": 2.636375}, {"id": "r6_042", "text": "Burn them out with a molly under the stairs.", "full_ms": 193.1112000020221, "audio_s": 2.605}, {"id": "r6_043", "text": "When I Y'L go, loop round the back.", "full_ms": 202.41610001539811, "audio_s": 2.65}, {"id": "r6_044", "text": "Flash when I call it.", "full_ms": 131.95300003280863, "audio_s": 1.7365}, {"id": "r6_045", "text": "Flash the opposite doorway.", "full_ms": 131.01650000317022, "audio_s": 2.1}, {"id": "r6_046", "text": "Be ready to trade me when I swing.", "full_ms": 171.2120000156574, "audio_s": 2.19}, {"id": "r6_047", "text": "I'm down. Pick me up.", "full_ms": 159.29569996660575, "audio_s": 2.00725}, {"id": "r6_048", "text": "Rotate over to where I marked.", "full_ms": 159.77600001497194, "audio_s": 2.23}, {"id": "r6_049", "text": "drone me in before we commit", "full_ms": 139.18950001243502, "audio_s": 2.05}, {"id": "r6_050", "text": "Bandit tricking the reinforced on main wall.", "full_ms": 185.3603000054136, "audio_s": 2.676875}, {"id": "r6_051", "text": "breach that wall on my go.", "full_ms": 144.95240000542253, "audio_s": 1.995}, {"id": "r6_052", "text": "Vocum top of stairs", "full_ms": 137.14280002750456, "audio_s": 2.02}, {"id": "r6_053", "text": "Hard breach that wall.", "full_ms": 122.73050000658259, "audio_s": 1.697125}, {"id": "r6_054", "text": "Keep your crosshair on the long hallway.", "full_ms": 173.65929996594787, "audio_s": 2.54}, {"id": "r6_055", "text": "Nade that room.", "full_ms": 117.03389999456704, "audio_s": 1.395}, {"id": "r6_056", "text": "on 3-way entry.", "full_ms": 129.1410000412725, "audio_s": 1.5845}, {"id": "r6_057", "text": "I got left door, you hold the right one.", "full_ms": 198.4539999975823, "audio_s": 2.946875}, {"id": "r6_058", "text": "Drop a cloud so we can cross.", "full_ms": 159.71229999559, "audio_s": 2.285}, {"id": "r6_059", "text": "Go in through the other window.", "full_ms": 143.15600000554696, "audio_s": 1.9035}]}