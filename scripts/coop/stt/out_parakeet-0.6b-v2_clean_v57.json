{"summary": {"engine": "parakeet-0.6b-v2", "cond": "clean", "n": 80, "load_s": 1.920502300024964, "rss_mb": 697.015625, "peak_mb": 769.7421875, "cores_busy": 2.5134404180952186, "audio_s_avg": 2.4567539062499995, "full_ms_med": 229.38420000718907, "full_ms_p95": 326.0418749967357, "tail_ms_med": null, "tail_ms_p95": null, "rtf_streamed": null, "same_text_streamed": null, "threads": "2"}, "rows": [{"id": "r6v57_000", "text": "Switch weapons.", "full_ms": 168.27350005041808, "audio_s": 1.58}, {"id": "r6v57_001", "text": "Hop out of the car, we're pushing in on foot.", "full_ms": 279.2893999721855, "audio_s": 3.11}, {"id": "r6v57_002", "text": "Reload.", "full_ms": 138.75229994300753, "audio_s": 1.1845}, {"id": "r6v57_003", "text": "Go grab some ammo, you're nearly dry.", "full_ms": 270.82770003471524, "audio_s": 2.9}, {"id": "r6v57_004", "text": "Cover me while I reload, I'm empty.", "full_ms": 257.886600040365, "audio_s": 2.75}, {"id": "r6v57_005", "text": "Get behind the truck, there's a glaze holding the long sight line.", "full_ms": 328.58929998474196, "audio_s": 3.782}, {"id": "r6v57_006", "text": "You're out of ammo, pull your sidearm.", "full_ms": 262.910199991893, "audio_s": 2.815}, {"id": "r6v57_007", "text": "Jump down here.", "full_ms": 165.3140999842435, "audio_s": 1.535}, {"id": "r6v57_008", "text": "Get out.", "full_ms": 134.51549998717383, "audio_s": 1.1845}, {"id": "r6v57_009", "text": "You're unlike three bullets, swap mags.", "full_ms": 281.8525999900885, "audio_s": 3.185}, {"id": "r6v57_010", "text": "Get out of there, Ying's about to flash you.", "full_ms": 267.416000016965, "audio_s": 2.905}, {"id": "r6v57_011", "text": "Primary is dry, go to your secondary.", "full_ms": 254.332099983003, "audio_s": 2.80225}, {"id": "r6v57_012", "text": "Pick up that shotgun, it's way better for anchoring.", "full_ms": 307.3652000166476, "audio_s": 3.446875}, {"id": "r6v57_013", "text": "He's reloading. He's reloading.", "full_ms": 245.44019997119904, "audio_s": 2.63}, {"id": "r6v57_014", "text": "Bail out of the truck, it's about to get blown up.", "full_ms": 272.6020999834873, "audio_s": 3.0175}, {"id": "r6v57_015", "text": "Get the shotgun out, it's all close quarters from now on.", "full_ms": 325.90779999736696, "audio_s": 3.8}, {"id": "r6v57_016", "text": "Hide right here till their drone's gone.", "full_ms": 229.11130002466962, "audio_s": 2.425}, {"id": "r6v57_017", "text": "Top off before we push.", "full_ms": 199.94479999877512, "audio_s": 2.051625}, {"id": "r6v57_018", "text": "Grab your shotgun, they're coming through the hatch.", "full_ms": 286.26109997276217, "audio_s": 3.155}, {"id": "r6v57_019", "text": "On my call, swap to your pistol.", "full_ms": 260.2045999956317, "audio_s": 2.83}, {"id": "r6v57_020", "text": "There's a rifle on my pin, go get it.", "full_ms": 245.03940000431612, "audio_s": 2.636375}, {"id": "r6v57_021", "text": "Get out, get out, they're lighting up the car.", "full_ms": 294.9081999831833, "audio_s": 3.385}, {"id": "r6v57_022", "text": "Just shoot, no time to swap guns.", "full_ms": 270.40520001901314, "audio_s": 3.01}, {"id": "r6v57_023", "text": "Drop down through that hatch, I'll watch the stairs.", "full_ms": 280.2411000011489, "audio_s": 3.175625}, {"id": "r6v57_024", "text": "Get a fresh mag in while they're rotating.", "full_ms": 230.27430003276095, "audio_s": 2.55}, {"id": "r6v57_025", "text": "Mag's empty and there's no time, just swap to the pistol.", "full_ms": 324.845600000117, "audio_s": 3.84}, {"id": "r6v57_026", "text": "Find ammo upstairs before we hit sight.", "full_ms": 250.10289996862411, "audio_s": 2.694625}, {"id": "r6v57_027", "text": "Go find a shotgun, your SMG isn't cutting it.", "full_ms": 334.9405000335537, "audio_s": 3.685}, {"id": "r6v57_028", "text": "Jump out, we walk the rest of the way.", "full_ms": 254.88389999372885, "audio_s": 2.765}, {"id": "r6v57_029", "text": "Find cover over there behind the sofa, ashes spraying through the wall.", "full_ms": 347.0866999705322, "audio_s": 3.9845}, {"id": "r6v57_030", "text": "Switch back to your rifle, smoke's dead.", "full_ms": 277.57149998797104, "audio_s": 3.0}, {"id": "r6v57_031", "text": "Throw a new mag in, quick, they're about to swing.", "full_ms": 316.705200006254, "audio_s": 3.63}, {"id": "r6v57_032", "text": "Jump out the south window.", "full_ms": 186.43190001603216, "audio_s": 1.863}, {"id": "r6v57_033", "text": "Jump off the balcony down to the first floor, it's faster than the stairs.", "full_ms": 385.6478999950923, "audio_s": 4.486875}, {"id": "r6v57_034", "text": "Restock at the ammo crate in the basement.", "full_ms": 232.2406999883242, "audio_s": 2.525}, {"id": "r6v57_035", "text": "Next weapon.", "full_ms": 153.55999994790182, "audio_s": 1.377}, {"id": "r6v57_036", "text": "Leave the vehicle when I say go, not before.", "full_ms": 281.4436999615282, "audio_s": 3.125}, {"id": "r6v57_037", "text": "Change mags, I've got the door covered.", "full_ms": 266.92739996360615, "audio_s": 2.905}, {"id": "r6v57_038", "text": "Spare ammos on the second floor if you need it.", "full_ms": 254.61389997508377, "audio_s": 2.735125}, {"id": "r6v57_039", "text": "Go back to your primary, the Jaeger's down.", "full_ms": 276.7903000349179, "audio_s": 3.1}, {"id": "csv57_000", "text": "Switch to pistol.", "full_ms": 172.0414999872446, "audio_s": 1.66}, {"id": "csv57_001", "text": "Reload bro.", "full_ms": 154.1595999733545, "audio_s": 1.377}, {"id": "csv57_002", "text": "Hop out of the car.", "full_ms": 166.30959999747574, "audio_s": 1.57}, {"id": "csv57_003", "text": "Go grab some ammo or running low.", "full_ms": 218.31179998116568, "audio_s": 2.31}, {"id": "csv57_004", "text": "Cover me bro I'm reloading.", "full_ms": 204.3843000428751, "audio_s": 2.02}, {"id": "csv57_005", "text": "Get behind the car man they're spraying", "full_ms": 227.92869998374954, "audio_s": 2.4453125}, {"id": "csv57_006", "text": "Your rifle is dry bro switch.", "full_ms": 222.3197999992408, "audio_s": 2.355}, {"id": "csv57_007", "text": "Get out bro.", "full_ms": 152.682600019034, "audio_s": 1.368125}, {"id": "csv57_008", "text": "Fresh magnow were almost dry.", "full_ms": 229.6570999897085, "audio_s": 2.42}, {"id": "csv57_009", "text": "Yo get out of there they're flanking you.", "full_ms": 230.1885000197217, "audio_s": 2.42}, {"id": "csv57_010", "text": "Pull out the shotgun man at close quarters.", "full_ms": 255.01609995262697, "audio_s": 2.739}, {"id": "csv57_011", "text": "Just jump down bro it's faster.", "full_ms": 218.42130000004545, "audio_s": 2.305}, {"id": "csv57_012", "text": "Pick up that shotgun.", "full_ms": 182.01749998843297, "audio_s": 1.79}, {"id": "csv57_013", "text": "Change mags while it's quiet.", "full_ms": 205.0292000058107, "audio_s": 2.109875}, {"id": "csv57_014", "text": "Grab or sidearm.", "full_ms": 176.5845000045374, "audio_s": 1.69}, {"id": "csv57_015", "text": "On my call jump out of the truck.", "full_ms": 214.21669999836013, "audio_s": 2.265}, {"id": "csv57_016", "text": "Swap guns.", "full_ms": 165.73210002388805, "audio_s": 1.544}, {"id": "csv57_017", "text": "I'm out of ammo man.", "full_ms": 179.674300015904, "audio_s": 1.82}, {"id": "csv57_018", "text": "Find cover over there.", "full_ms": 182.6275999774225, "audio_s": 1.81}, {"id": "csv57_019", "text": "Use your rifle they're way too far for a pistol.", "full_ms": 257.3755999910645, "audio_s": 2.76675}, {"id": "csv57_020", "text": "There's a rifle by my ping go get it.", "full_ms": 235.7287000049837, "audio_s": 2.535}, {"id": "csv57_021", "text": "Exit the vehicle man were here.", "full_ms": 206.74789999611676, "audio_s": 2.15}, {"id": "csv57_022", "text": "Top off before we push.", "full_ms": 200.99230000050738, "audio_s": 2.051625}, {"id": "csv57_023", "text": "Forget the pistol just start shooting.", "full_ms": 228.8336000056006, "audio_s": 2.41}, {"id": "csv57_024", "text": "Drop down there on 3.", "full_ms": 195.20889996783808, "audio_s": 1.96}, {"id": "csv57_025", "text": "You're out of ammo just switch weapons.", "full_ms": 228.12319995136932, "audio_s": 2.44275}, {"id": "csv57_026", "text": "Dude on the right has a shotgun careful.", "full_ms": 234.2740999883972, "audio_s": 2.495}, {"id": "csv57_027", "text": "Get out, the car's on fire!", "full_ms": 230.00989999854937, "audio_s": 2.45}, {"id": "csv57_028", "text": "Go secondary.", "full_ms": 162.5472999876365, "audio_s": 1.5035}, {"id": "csv57_029", "text": "Find a gun bro you're empty.", "full_ms": 210.92250000219792, "audio_s": 2.155}, {"id": "csv57_030", "text": "Reload real quick nobody is here.", "full_ms": 212.5382999656722, "audio_s": 2.205}, {"id": "csv57_031", "text": "Jump in the truck.", "full_ms": 166.79590003332123, "audio_s": 1.56675}, {"id": "csv57_032", "text": "Hide here quick.", "full_ms": 160.63820000272244, "audio_s": 1.505}, {"id": "csv57_033", "text": "Back to primary man.", "full_ms": 197.0978999743238, "audio_s": 1.95}, {"id": "csv57_034", "text": "Reloading, hold that door for me.", "full_ms": 227.85810002824292, "audio_s": 2.425}, {"id": "csv57_035", "text": "Leave the truck we walk from here.", "full_ms": 205.97140002064407, "audio_s": 2.19}, {"id": "csv57_036", "text": "Get the ammo upstairs.", "full_ms": 199.5632000034675, "audio_s": 1.935}, {"id": "csv57_037", "text": "Throw a new mag in.", "full_ms": 172.0809999969788, "audio_s": 1.68325}, {"id": "csv57_038", "text": "Hop off the ledge.", "full_ms": 168.73899998608977, "audio_s": 1.61}, {"id": "csv57_039", "text": "Take out your sidearm it's faster than reloading.", "full_ms": 274.5596999884583, "audio_s": 2.97}]}