  {
   "id": "sttv56_023",
   "text": "эм, иди наверх"
  },
  {
   "id": "seed_DEFUSE_6",
   "text": "дефузь сейчас"
  },
  {
   "id": "csv5_047",
   "text": "лёркер сзади, слышу его шаги"
