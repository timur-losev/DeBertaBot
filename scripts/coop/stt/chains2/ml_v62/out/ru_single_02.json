  {
   "id": "seed_TAKE_COVER_26",
   "text": "головы ниже"
  },
  {
   "id": "seed_DRONE_5",
   "text": "разведай впереди"
  },
  {
   "id": "csv52_020",
   "text": "а, меня положили, помоги, подними меня"
  },
  {
   "id": "seed_SUPPRESS_30",
   "text": "подави огнём восточное окно"
  },
  {
   "id": "seed_ATTACK_25",
   "text": "найди противника"
