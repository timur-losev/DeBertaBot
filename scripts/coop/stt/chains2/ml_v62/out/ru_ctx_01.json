   "before": [
    "проверь подвал",
    "э, иди к двери в подвал"
   ],
   "text": "э, не заходи туда"
  },
  {
   "id": "x59_stt_010",
   "before": [
    "стой тут"
   ],
   "text": "э, ладно, спустись по ступенькам, потом за мной"
  },
  {
   "id": "x58_r6_012",
   "before": [
    "Иди к красной лестнице."
   ],
   "text": "Попробуй ещё раз справа."
  },
  {
   "id": "x58_cs_033",
   "before": [
    "спускайся по лестнице"
   ],
   "text": "продолжай"
  },
  {
   "id": "x_r6_054",
   "before": [
    "Иди на верхний этаж.",
    "Зажми красную лестницу."
   ],
   "text": "Ещё разок."
  },
  {
   "id": "x_cs_010",
   "before": [
    "держи главный",
    "смок на кухню"
   ],
   "text": "хотя не, молик туда кинь"
  },
  {
   "id": "x55_r6_045",
   "before": [
    "Закинь смок в окно."
   ],
   "text": "Вот сюда."
  },
  {
   "id": "x55_cs_030",
   "before": [
    "один остался",
    "он где-то нычется",
    "иди проверь"
   ],
   "text": "вон ту комнату"
  },
  {
   "id": "x_stt_027",
   "before": [
    "поставь дым на западное окно"
   ],
   "text": "и, и восточное окно"
  },
  {
   "id": "x_stt_049",
   "before": [
    "кинь гранату в подвал"
   ],
   "text": "первую"
  },
  {
   "id": "x58_cs_016",
   "before": [
    "за мной",
    "беги к машине"
   ],
   "text": "залезай внутрь, бро"
  },
  {
   "id": "x58_stt_035",
   "before": [
    "иди за мной",
    "давай на крышу"
   ],
   "text": "попробуй ещё раз у моей метки"
  },
  {
   "id": "x_r6_133",
   "before": [
    "Подави их огнём."
   ],
   "text": "Северное окно."
  },
  {
   "id": "x55_cs_001",
   "before": [
    "кинь смок"
   ],
   "text": "вот на эту дверь, чел"
  },
  {
   "id": "x_cs_053",
   "before": [
    "иди к жёлтой лестнице"
   ],
   "text": "держи синюю лестницу"
  },
  {
   "id": "x_r6_079",
   "before": [
    "За мной."
   ],
   "text": "Перелезь в северное окно и проверь верхний этаж."
  },
  {
   "id": "x_r6_053",
   "before": [
    "Кинь дым на белую лестницу."
   ],
   "text": "Нет, светошумовую."
  },
  {
   "id": "x_stt_105",
   "before": [
    "чекни подвал"
   ],
   "text": "не подвал, верхний этаж"
  },
  {
   "id": "x_r6_023",
   "before": [
    "Кинь флешку в южную дверь."
   ],
   "text": "Потом в главную дверь."
  },
  {
   "id": "x_r6_084",
   "before": [
    "Иди к синей лестнице."
   ],
   "text": "Держи красную лестницу."
  },
  {
   "id": "x55_stt_002",
   "before": [
    "э, задыми восточную дверь"
   ],
   "text": "окей, теперь проверь подвал"
  },
  {
   "id": "x_cs_059",
   "before": [
    "пушь на кухню"
   ],
   "text": "теперь подвал"
  },
  {
   "id": "x55_cs_014",
   "before": [
    "гг",
    "эко раунд, пацаны",
    "двое на Б",
    "за мной",
    "смок на главную дверь"
   ],
   "text": "ещё раз"
  },
  {
   "id": "x_r6_132",
   "before": [
    "Займи позицию у восточной стены."
   ],
   "text": "Бричь её, потом заходи."
  },
  {
   "id": "x_r6_013",
   "before": [
    "Смотри за восточным окном."
   ],
   "text": "Открой восточную дверь."
  },
  {
   "id": "x_r6_049",
   "before": [
    "Посмотри на восточное окно."
   ],
   "text": "Не просто смотри, держи его."
  },
  {
   "id": "x_r6_058",
   "before": [
    "Проверь восточное окно."
   ],
   "text": "И западное окно."
  },
  {
   "id": "x55_r6_044",
   "before": [
    "Перелезь через окно."
   ],
   "text": "Вот через это, тут."
  },
  {
   "id": "x58_cs_025",
   "before": [
    "иди влево"
   ],
   "text": "ещё левее"
  },
  {
   "id": "x55_cs_053",
   "before": [
    "эко раунд, лол",
    "за мной",
    "стоп",
    "двое на Б",
    "смотри за жёлтой лестницей"
   ],
   "text": "присядь, бро"
  },
  {
   "id": "x59_cs_019",
   "before": [
    "двое на кухне"
   ],
   "text": "рашь на кухню и зачисти её"
  },
  {
   "id": "x55_cs_024",
   "before": [
    "иди к красной лестнице"
   ],
   "text": "не, не иди туда"
  },
  {
   "id": "x55_r6_018",
   "before": [
    "Двое пушат подвал.",
    "Держи синюю лестницу.",
    "Красава, так и держи, плотно."
   ],
   "text": "Найди пушку, потом возвращайся."
  },
  {
   "id": "x59_r6_033",
   "before": [
    "Ложись.",
    "Спрячься за машиной.",
    "В укрытие за машину, быстро!",
    "Посмотри на коричневую лестницу."
   ],
   "text": "Не, на мою метку."
  },
  {
   "id": "x58_r6_017",
   "before": [
    "Кинь смок на восточное окно."
   ],
   "text": "Двигайся дальше."
  },
  {
   "id": "x58_r6_004",
   "before": [
    "Капканы на дверях.",
    "Отстрели ту камеру."
   ],
   "text": "Следующую."
  },
  {
   "id": "x_r6_128",
   "before": [],
   "text": "Да."
  },
  {
   "id": "x_cs_073",
   "before": [
    "держи угол"
   ],
   "text": "красную лестницу"
  },
  {
   "id": "x59_r6_007",
   "before": [
    "Кавейра бродит снаружи, аккуратнее."
   ],
   "text": "Спустись по коричневой лестнице и садись в грузовик."
  },
  {
   "id": "x_cs_072",
   "before": [
    "проверь крышу",
    "не вижу его"
   ],
   "text": "ещё раз"
  },
  {
   "id": "x_cs_098",
   "before": [
    "смок на западную дверь",
    "красава"
   ],
   "text": "дым на главную"
  },
  {
   "id": "x_stt_048",
   "before": [],
   "text": "не, не, задыми её"
  },
  {
   "id": "x_stt_071",
   "before": [
    "ставь бомбу"
   ],
   "text": "не-не, дефузь, в смысле дефузь"
  },
  {
   "id": "x_stt_001",
   "before": [],
   "text": "не, просто открой её"
  },
  {
   "id": "x_cs_117",
   "before": [
    "дым на северную дверь"
   ],
   "text": "флешани её и заходи"
  },
  {
   "id": "x_stt_024",
   "before": [
    "иди к северной двери"
   ],
   "text": "открой её и потом заходи"
  },
  {
   "id": "x59_r6_027",
   "before": [
    "Стреляй в люк.",
    "Ещё раз стреляй в люк.",
    "Смотри за синей лестницей."
   ],
   "text": "За белой лестницей."
  },
  {
   "id": "x58_cs_006",
   "before": [
    "он лоу",
    "давай к тому люку",
    "найс"
   ],
   "text": "прыгай в него"
  },
  {
   "id": "x58_stt_056",
   "before": [
    "э, проверь кухню"
   ],
   "text": "держи тут позицию"
  },
  {
   "id": "x_r6_071",
   "before": [
    "Держи главную дверь.",
    "Смок на восточную дверь."
   ],
   "text": "Не стреляй."
  },
  {
   "id": "x58_stt_010",
   "before": [
    "проверь подвал",
    "окей, чисто",
    "иди к южному окну"
   ],
   "text": "э, открой его и смотри"
  },
  {
   "id": "x55_stt_037",
   "before": [
    "так, короче",
    "смотри за красной лестницей",
    "двое идут",
    "граник на лестницу"
   ],
   "text": "то же самое ещё раз"
  },
  {
   "id": "x55_r6_014",
   "before": [
    "Флешку в восточное окно."
   ],
   "text": "Сделай так ещё раз."
  },
  {
   "id": "x_r6_061",
   "before": [
    "Иди к восточной двери."
   ],
   "text": "И стой там."
  },
  {
   "id": "x59_stt_033",
   "before": [
    "флешку на кухню",
    "флешани её",
    "кинь ещё флешку",
    "открой южную дверь"
   ],
   "text": "э, нет, другую"
  },
  {
   "id": "x_r6_091",
   "before": [
    "Проверь кухню."
   ],
   "text": "Кинь туда граник."
  },
  {
   "id": "x58_stt_001",
   "before": [
    "окей, спускайся в подвал",
    "вниз"
   ],
   "text": "зачисти его, зачисти"
  },
  {
   "id": "x58_stt_015",
   "before": [
    "окей, иди к фургону"
   ],
   "text": "садись"
  },
  {
   "id": "x58_r6_024",
   "before": [
    "Дрон пошёл.",
    "Двое на кухне, один из них Йегер.",
    "Иди к ящику у дивана."
   ],
   "text": "Проверь за ним."
  },
  {
   "id": "x_r6_120",
   "before": [
    "Смотри за восточным окном."
   ],
   "text": "За мной."
  },
  {
   "id": "x_cs_109",
   "before": [],
   "text": "нет"
  },
  {
   "id": "x_stt_031",
   "before": [
    "флешку в главную дверь"
   ],
   "text": "потом, потом южную дверь"
  },
  {
   "id": "x_r6_087",
   "before": [
    "Проверь дверь."
   ],
   "text": "Ту, что слева."
  },
  {
   "id": "x_cs_005",
   "before": [
    "иди на крышу"
   ],
   "text": "спрыгивай"
  },
  {
   "id": "x_cs_050",
   "before": [
    "переходи на главный",
    "смок на восточную дверь"
   ],
   "text": "огонь не открывай"
  },
  {
   "id": "x_cs_032",
   "before": [
    "обойди их с фланга"
   ],
   "text": "через главный"
  },
  {
   "id": "x55_stt_055",
   "before": [
    "иди найди броню",
    "садись в машину"
   ],
   "text": "в ту, что у моей метки"
  },
  {
   "id": "x55_cs_029",
   "before": [
    "чекни машину"
   ],
   "text": "не, ту, что у моего пина"
  },
  {
   "id": "x58_r6_030",
   "before": [
    "Мира на стене.",
    "Двое на кухне.",
    "Флешку в проход.",
    "Хорошая флешка."
   ],
   "text": "Ещё один."
  },
  {
   "id": "x_cs_116",
   "before": [
    "за мной",
    "продронь кухню"
   ],
   "text": "лучше гараж"
  },
  {
   "id": "x_cs_008",
   "before": [
    "запусти дрон в подвал"
   ],
   "text": "не стреляй, отходи"
  },
  {
   "id": "x_cs_028",
   "before": [
    "держи красную лестницу"
   ],
   "text": "не лестницу, главную дверь"
  },
  {
   "id": "x55_stt_022",
   "before": [
    "окей, иди на балкон"
   ],
   "text": "э, не прыгай вниз"
  },
  {
   "id": "x_r6_064",
   "before": [
    "Иди к южной двери."
   ],
   "text": "Пробей её зарядом, потом заходи."
  },
  {
   "id": "x58_stt_036",
   "before": [
    "кинь гранату в восточное окно"
   ],
   "text": "э, давай ещё раз, вон туда"
  },
  {
   "id": "x_cs_030",
   "before": [
    "иди к западному окну"
   ],
   "text": "открой его и залезай внутрь"
  },
  {
   "id": "x_cs_090",
   "before": [
    "иди к дивану",
    "зажми северную дверь"
   ],
   "text": "сделай так ещё раз"
  },
  {
   "id": "x58_cs_028",
   "before": [
    "вернись ко мне"
   ],
   "text": "давай, продолжай идти"
  },
  {
   "id": "x58_cs_022",
   "before": [
    "залезай в тот грузовик",
    "они пушат лонг"
   ],
   "text": "вылезай из него, бро"
  },
  {
   "id": "x55_cs_002",
   "before": [
    "за мной"
   ],
   "text": "хотя нет, не иди за мной"
  },
  {
   "id": "x_stt_059",
   "before": [
    "держи коричневую лестницу"
   ],
   "text": "кинь туда смок, а потом флешку"
  },
  {
   "id": "x_cs_015",
   "before": [
    "флешку на кухню"
   ],
   "text": "я сказал кухню"
  },
  {
   "id": "x58_r6_005",
   "before": [
    "Иди к тому грузовику.",
    "Двое пушат из гаража."
   ],
   "text": "Залезай внутрь."
  },
  {
   "id": "x55_r6_053",
   "before": [
    "Дрону конец.",
    "Двое на точке, один роумер.",
    "Укрепи восточную стену.",
    "Найс, роумер готов.",
    "Держи главную дверь."
   ],
   "text": "Бричь северную дверь по моей команде."
  },
  {
   "id": "x55_stt_040",
   "before": [
    "они на крыше",
    "подави их"
   ],
   "text": "на мой пин"
  },
  {
   "id": "x58_cs_045",
   "before": [
    "эко",
    "кинь смок на мою метку"
   ],
   "text": "не, вон туда"
  },
  {
   "id": "x58_cs_038",
   "before": [
    "за мной",
    "лезь на крышу"
   ],
   "text": "попробуй ещё раз с другой стороны, бро"
  },
  {
   "id": "x55_r6_011",
   "before": [
    "Смотри за лестницей."
   ],
   "text": "Вон за той, там."
  },
  {
   "id": "x58_stt_049",
   "before": [
    "найс",
    "подбери ту винтовку"
   ],
   "text": "ещё одну"
  },
  {
   "id": "x55_stt_050",
   "before": [
    "перелезь через окно"
   ],
   "text": "э, через то, что у моей метки"
  },
  {
   "id": "x_cs_003",
   "before": [
    "иди к лестнице"
   ],
   "text": "к белой"
  },
  {
   "id": "x58_stt_014",
   "before": [
    "за мной",
    "отлично",
    "иди к машине"
   ],
   "text": "э, запрыгивай"
  },
  {
   "id": "x55_r6_012",
   "before": [
    "Проверь за столом."
   ],
   "text": "Отставить, за тем, что у моего пина."
  },
  {
   "id": "x_cs_107",
   "before": [
    "чекни кухню",
    "смотри за западным окном"
   ],
   "text": "обойди через южную дверь"
  },
  {
   "id": "x55_cs_058",
   "before": [
    "начинай стрелять"
   ],
   "text": "по тому окну, бро"
  },
  {
   "id": "x55_stt_054",
   "before": [
    "проверь подвал"
   ],
   "text": "подбери тот дробовик и жди меня у машины"
  },
  {
   "id": "x_cs_114",
   "before": [
    "посмотри на стол"
   ],
   "text": "перепрыгни через него"
  },
  {
   "id": "x55_cs_039",
   "before": [
    "открывай огонь"
   ],
   "text": "по той машине, чел"
  },
  {
   "id": "x59_cs_016",
   "before": [
    "присядь"
   ],
   "text": "поднимись по коричневой лестнице, потом встань"
  },
  {
   "id": "x55_cs_019",
   "before": [
    "флешку в ту комнату"
   ],
   "text": "так же ещё раз"
  },
  {
   "id": "x_r6_098",
   "before": [
    "Флешку на кухню.",
    "Держи жёлтую лестницу."
   ],
   "text": "Не, синюю."
  },
  {
   "id": "x_stt_021",
   "before": [
    "проверь гараж",
    "иди к столу"
   ],
   "text": "посмотри на него"
  },
  {
   "id": "x58_stt_047",
   "before": [
    "проверь комнату"
   ],
   "text": "окей, следующую"
  },
  {
   "id": "x_r6_074",
   "before": [
    "Открой люк."
   ],
   "text": "Пробей эту стену зарядом."
  },
  {
   "id": "x58_cs_052",
   "before": [
    "найс выстрел",
    "он на одном хп"
   ],
   "text": "открой её, бро"
  },
  {
   "id": "x58_cs_046",
   "before": [
    "эко",
    "открой ту дверь"
   ],
   "text": "и ту тоже"
  },
  {
   "id": "x_cs_035",
   "before": [
    "проверь гараж",
    "граник в северное окно"
   ],
   "text": "в дверь, в смысле"
  },
  {
   "id": "x_stt_113",
   "before": [
    "флешку в восточную дверь",
    "он не ослеп"
   ],
   "text": "ещё одну флешку"
  },
  {
   "id": "x59_stt_003",
   "before": [],
   "text": "беги к грузовику и, эм, поставь дым на южное окно."
  },
  {
   "id": "x_cs_045",
   "before": [
    "открой северную дверь"
   ],
   "text": "тогда бричь её"
  },
  {
   "id": "x_cs_111",
   "before": [
    "держи главный"
   ],
   "text": "штурмуй кухню"
  },
  {
   "id": "x58_r6_049",
   "before": [
    "Двое на крыше.",
    "Садись в грузовик.",
    "Так, они пушат главный."
   ],
   "text": "Вылезай."
  },
  {
   "id": "x58_stt_020",
   "before": [
    "иди к машине",
    "садись"
   ],
   "text": "окей, выпрыгивай"
  },
  {
   "id": "x55_r6_055",
   "before": [
    "Смотри за красной лестницей."
   ],
   "text": "Не, за тем окном."
  },
  {
   "id": "x58_stt_050",
   "before": [
    "окей",
    "пробей восточную дверь зарядом"
   ],
   "text": "и ту тоже"
  },
  {
   "id": "x55_cs_010",
   "before": [
    "за мной",
    "давай, давай, двигай"
   ],
   "text": "к той машине"
  },
  {
   "id": "x58_cs_032",
   "before": [
    "гг",
    "эко раунд",
    "иди к моей метке"
   ],
   "text": "двигай дальше, бро"
  },
  {
   "id": "x59_stt_019",
   "before": [],
   "text": "заходи через главную дверь и, и зачисти комнату."
  },
  {
   "id": "x58_r6_043",
   "before": [
    "Бричь эту стену."
   ],
   "text": "И ту тоже."
  },
  {
   "id": "x_stt_081",
   "before": [
    "зачисти кухню"
   ],
   "text": "теперь гараж"
  },
  {
   "id": "x_cs_137",
   "before": [
    "перепрыгни через диван"
   ],
   "text": "и через стол"
  },
  {
   "id": "x55_r6_026",
   "before": [
    "Двое на точке, один роумер наверху.",
    "Залезь на крышу."
   ],
   "text": "Давай ещё попытку."
  },
  {
   "id": "x_stt_005",
   "before": [
    "открой восточную дверь"
   ],
   "text": "теперь посмотри на меня"
  },
  {
   "id": "x55_stt_056",
   "before": [
    "смок на главную дверь",
    "найс"
   ],
   "text": "э, пока не пробивай"
  },
  {
   "id": "x_stt_030",
   "before": [
    "проверь гараж",
    "оставайся там"
   ],
   "text": "кинь гранату в северное окно"
  },
  {
   "id": "x55_cs_000",
   "before": [
    "смотри за лестницей",
    "граник в восточное окно"
   ],
   "text": "закинь туда ещё граник"
  },
  {
   "id": "x_cs_014",
   "before": [
    "иди к красной лестнице"
   ],
   "text": "и стой там"
  },
  {
   "id": "x_cs_103",
   "before": [
    "держи жёлтую лестницу",
    "быстро"
   ],
   "text": "не, коричневую"
  },
  {
   "id": "x_r6_000",
   "before": [
    "Держи западную дверь."
   ],
   "text": "Дверь, а не окно."
  },
  {
   "id": "x55_stt_016",
   "before": [
    "проверь подвал",
    "э, иди вниз"
   ],
   "text": "нет, не иди туда"
  },
  {
   "id": "x58_stt_019",
   "before": [
    "э, садись в машину"
   ],
   "text": "вылезай"
  },
  {
   "id": "x58_cs_017",
   "before": [
    "гг изи",
    "эко",
    "у них AWP",
    "иди к грузовику"
   ],
   "text": "садись за руль"
  },
  {
   "id": "x_stt_006",
   "before": [],
   "text": "э, может быть"
  },
  {
   "id": "x58_cs_018",
   "before": [
    "двое на А",
    "иди к машине у моей метки"
   ],
   "text": "садись в неё"
  },
  {
   "id": "x_cs_057",
   "before": [
    "держи красную лестницу",
    "граник на кухню"
   ],
   "text": "стоп, стоп"
  },
  {
   "id": "x_r6_065",
   "before": [],
   "text": "Делай."
  },
  {
   "id": "x55_cs_046",
   "before": [
    "они пушат Б",
    "двое идут"
   ],
   "text": "не двигайся, бро"
  },
  {
   "id": "x58_stt_018",
   "before": [
    "где они",
    "иди к грузовику"
   ],
   "text": "залезай в него, залезай"
  },
  {
   "id": "x_stt_128",
   "before": [
    "спустись по верёвке к южному окну"
   ],
   "text": "открой его и кинь через него флешку"
  },
  {
   "id": "x59_stt_016",
   "before": [
    "за мной"
   ],
   "text": "хотя нет, поднимись по рампе и запрыгни на ящики"
  },
  {
   "id": "x55_r6_041",
   "before": [
    "Ловушки Капкана на дверях.",
    "Давай к лестнице."
   ],
   "text": "Где я отметил."
  },
  {
   "id": "x_cs_105",
   "before": [
    "переходи"
   ],
   "text": "на верхний этаж"
  },
  {
   "id": "x_r6_016",
   "before": [
    "Пробей восточную дверь зарядом."
   ],
   "text": "Потом главную дверь."
  },
  {
   "id": "x58_stt_027",
   "before": [
    "где они",
    "иди влево"
   ],
   "text": "давай дальше"
  },
  {
   "id": "x_r6_077",
   "before": [
    "Поднимись по красной лестнице."
   ],
   "text": "Не, по синей."
  },
  {
   "id": "x_r6_050",
   "before": [
    "Смотри за западным окном."
   ],
   "text": "Не, лучше задыми его."
  },
  {
   "id": "x_r6_100",
   "before": [
    "Проверь гараж.",
    "Открой южную дверь."
   ],
   "text": "Обойди через северную дверь."
  },
  {
   "id": "x58_cs_054",
   "before": [
    "иди к машине",
    "найс",
    "один остался"
   ],
   "text": "заходи в здание, бро"
  },
  {
   "id": "x55_stt_014",
   "before": [
    "окей, иди к лестнице"
   ],
   "text": "э, нет, вот здесь"
  },
  {
   "id": "x_stt_028",
   "before": [
    "кинь гранату в западное окно"
   ],
   "text": "ещё раз"
  },
  {
   "id": "x55_r6_017",
   "before": [],
   "text": "Запрыгивай, я за рулём."
  },
  {
   "id": "x_stt_013",
   "before": [
    "за мной"
   ],
   "text": "запрыгни на стол и посмотри на восточное окно"
  },
  {
   "id": "x_stt_112",
   "before": [
    "иди к лестнице"
   ],
   "text": "к коричневой"
  },
  {
   "id": "x_stt_098",
   "before": [
    "открой дверь"
   ],
   "text": "я не знаю"
  },
  {
   "id": "x55_cs_032",
   "before": [
    "смотри за той дверью"
   ],
   "text": "не, пока не стреляй"
  },
  {
   "id": "x_r6_027",
   "before": [],
   "text": "Ставь дефузер."
  },
  {
   "id": "x59_r6_012",
   "before": [],
   "text": "Сдвинься вправо, посмотри на жёлтую лестницу."
  },
  {
   "id": "x55_cs_017",
   "before": [
    "у меня хп почти нет, капец"
   ],
   "text": "сходи за аптечкой, бро"
  },
  {
   "id": "x_cs_115",
   "before": [],
   "text": "лол, красивый выстрел"
  },
  {
   "id": "x59_cs_039",
   "before": [],
   "text": "кинь смок на восточное окно, потом ложись"
  },
  {
   "id": "x59_stt_021",
   "before": [
    "по нам стреляют"
   ],
   "text": "давай к грузовику и пригнись за ним"
  },
  {
   "id": "x_r6_129",
   "before": [
    "Продронь верхний этаж."
   ],
   "text": "Не тот этаж, подвал."
  },
  {
   "id": "x58_cs_007",
   "before": [
    "подойди к тому ящику"
   ],
   "text": "залезь на него, бро"
  },
  {
   "id": "x_stt_139",
   "before": [
    "иди на верхний этаж",
    "подави огнём жёлтую лестницу"
   ],
   "text": "ещё разок"
  },
  {
   "id": "x_stt_099",
   "before": [
    "держи красную лестницу",
    "бричь восточную дверь"
   ],
   "text": "не-не, западную"
  },
  {
   "id": "x58_stt_002",
   "before": [
    "где они",
    "э, давай к западному окну"
   ],
   "text": "окей, перелезь через него"
  },
  {
   "id": "x_stt_136",
   "before": [
    "дым на красную лестницу",
    "смотри за кухней"
   ],
   "text": "кинь туда гранату"
  },
  {
   "id": "x_stt_066",
   "before": [
    "иди к красной лестнице",
    "граник на кухню"
   ],
   "text": "стоп, стоп, стоп"
  },
  {
   "id": "x_r6_012",
   "before": [
    "Держи красную лестницу."
   ],
   "text": "Отрицательно."
  },
  {
   "id": "x59_r6_028",
   "before": [
    "Иди к восточной двери.",
    "К восточной двери, живо.",
    "Проверь детскую."
   ],
   "text": "Вон там."
  },
  {
   "id": "x55_cs_036",
   "before": [
    "кинь туда молик"
   ],
   "text": "ещё раз"
  },
  {
   "id": "x_cs_036",
   "before": [
    "дрон на верхний этаж"
   ],
   "text": "теперь подвал"
  },
  {
   "id": "x58_r6_021",
   "before": [
    "Гранату в западное окно."
   ],
   "text": "Попробуй ещё раз у моей метки."
  },
  {
   "id": "x_stt_042",
   "before": [
    "в укрытие"
   ],
   "text": "за диваном"
  },
  {
   "id": "x59_r6_021",
   "before": [
    "Глаз на крыше сарая, он держит угол."
   ],
   "text": "Беги к грузовику и спрячься за ним."
  },
  {
   "id": "x58_r6_031",
   "before": [
    "Термит на стене.",
    "Проверь подвал."
   ],
   "text": "Иди вон туда."
  },
  {
   "id": "x59_cs_024",
   "before": [],
   "text": "давай, давай, дефузь бомбу"
  },
  {
   "id": "x58_stt_005",
   "before": [
    "видишь ту вентиляцию",
    "иди к вентиляции"
   ],
   "text": "э, залезь в неё"
  },
  {
   "id": "x55_stt_001",
   "before": [
    "за мной",
    "кинь граник в восточное окно"
   ],
   "text": "попробуй ещё раз"
  },
  {
   "id": "x58_stt_033",
   "before": [
    "найс",
    "иди вперёд"
   ],
   "text": "давай, давай, дальше"
  },
  {
   "id": "x55_r6_057",
   "before": [
    "Термит на восточной стене.",
    "Двое на точке, один в баре.",
    "Прикрывай мне спину.",
    "Окей, двигаюсь.",
    "Иди к красной лестнице."
   ],
   "text": "Давай ещё раз."
  },
  {
   "id": "x58_r6_040",
   "before": [
    "Мира на восточной стене.",
    "Иди к грузовику."
   ],
   "text": "Залезай в него."
  },
  {
   "id": "x59_stt_022",
   "before": [],
   "text": "пригнись, пригнись и не светись"
  },
  {
   "id": "x59_r6_032",
   "before": [
    "Держи главную дверь.",
    "Продронь кухню.",
    "Держи главный, они пикают.",
    "Стреляй по тому окну."
   ],
   "text": "Не, по восточному."
  },
  {
   "id": "x_stt_107",
   "before": [
    "поднимись по синей лестнице"
   ],
   "text": "нет, по красной"
  },
  {
   "id": "x_r6_019",
   "before": [
    "Гранату в северное окно."
   ],
   "text": "Ещё раз."
  },
  {
   "id": "x59_cs_027",
   "before": [
    "граник в главную дверь",
    "граник в северное окно",
    "посмотри на лестницу"
   ],
   "text": "не, на белую, бро"
  },
  {
   "id": "x_cs_012",
   "before": [
    "проверь подвал"
   ],
   "text": "прыгай вниз"
  },
  {
   "id": "x55_r6_023",
   "before": [
    "Кухня чистая."
   ],
   "text": "Не делай этого."
  },
  {
   "id": "x_stt_077",
   "before": [
    "кинь гранату в восточное окно"
   ],
   "text": "в дверь, не в окно"
  },
  {
   "id": "x55_cs_043",
   "before": [
    "беги"
   ],
   "text": "к моему пину, бро"
  },
  {
   "id": "x59_stt_039",
   "before": [],
   "text": "не стреляй и, эм, подпусти их ближе"
  },
  {
   "id": "x55_cs_016",
   "before": [
    "зажми их"
   ],
   "text": "у той двери"
  },
  {
   "id": "x58_cs_005",
   "before": [
    "за мной",
    "иди к вентиляции"
   ],
   "text": "залезай в неё"
  },
  {
   "id": "x_r6_038",
   "before": [
    "Проверь кухню.",
    "Граник в северное окно."
   ],
   "text": "То же самое в южное."
  },
  {
   "id": "x_cs_000",
   "before": [
    "иди к люку",
    "открой его"
   ],
   "text": "теперь прыгай в него"
  },
  {
   "id": "x_r6_073",
   "before": [
    "Бричь западную дверь."
   ],
   "text": "Открой восточную дверь."
  },
  {
   "id": "x58_cs_009",
   "before": [
    "они там",
    "иди к той комнате"
   ],
   "text": "заходи в неё"
  },
  {
   "id": "x55_stt_009",
   "before": [
    "пробей западную дверь зарядом"
   ],
   "text": "не делай этого"
  },
  {
   "id": "x_stt_009",
   "before": [
    "бричь восточную дверь"
   ],
   "text": "не бричь, просто открой её"
  },
  {
   "id": "x_cs_054",
   "before": [
    "смок на главный"
   ],
   "text": "ставь бомбу"
  },
  {
   "id": "x59_cs_032",
   "before": [
    "дым на северное окно",
    "задыми его ещё раз",
    "открой дверь"
   ],
   "text": "не, другую"
  },
  {
   "id": "x59_r6_000",
   "before": [],
   "text": "Поднимись по синей лестнице и перепрыгни через стол."
  },
  {
   "id": "x_stt_126",
   "before": [
    "штурмуй гараж"
   ],
   "text": "подожди, подожди"
  },
  {
   "id": "x58_stt_055",
   "before": [
    "за мной",
    "смотри за южным окном"
   ],
   "text": "окей, иди вон туда"
  },
  {
   "id": "x58_r6_000",
   "before": [
    "Бар чистый.",
    "Иди к машине."
   ],
   "text": "Запрыгивай."
  },
  {
   "id": "x_stt_039",
   "before": [
    "смотри за южной дверью"
   ],
   "text": "не-не, задыми её"
  },
  {
   "id": "x58_r6_037",
   "before": [
    "Роумер наверху.",
    "Давай к синей лестнице."
   ],
   "text": "И наверх."
  },
  {
   "id": "x_r6_110",
   "before": [
    "Кинь светошумовую в южную дверь.",
    "Мимо."
   ],
   "text": "Ещё одну."
  },
  {
   "id": "x55_r6_051",
   "before": [
    "Смотри фланг.",
    "Смок на синюю лестницу."
   ],
   "text": "Ещё раз смок."
  },
  {
   "id": "x59_stt_036",
   "before": [
    "один в ванной"
   ],
   "text": "флешку в ванную и потом открывай огонь"
  },
  {
   "id": "x58_stt_032",
   "before": [
    "давай к лестнице",
    "поднимайся по ступенькам"
   ],
   "text": "и выше"
  },
  {
   "id": "x_r6_008",
   "before": [
    "Иди на второй этаж.",
    "Быстрее."
   ],
   "text": "Не, погоди, на верхний этаж."
  },
  {
   "id": "x55_cs_051",
   "before": [
    "задыми южную дверь"
   ],
   "text": "задыми её ещё раз, бро"
  },
  {
   "id": "x55_stt_057",
   "before": [
    "иди на крышу"
   ],
   "text": "окей, поднимись по красной лестнице"
  },
  {
   "id": "x_stt_060",
   "before": [
    "проверь кухню",
    "гранату в южное окно"
   ],
   "text": "э, то же самое в северное"
  },
  {
   "id": "x55_r6_046",
   "before": [
    "Иди к жёлтой лестнице.",
    "Погоди, клеймор на лестнице."
   ],
   "text": "Не двигайся."
  },
  {
   "id": "x_cs_095",
   "before": [
    "обходи справа"
   ],
   "text": "нет, слева"
  },
  {
   "id": "x58_r6_015",
   "before": [
    "Чисто.",
    "Иди к коричневой лестнице."
   ],
   "text": "Не, к белой."
  },
  {
   "id": "x58_stt_024",
   "before": [
    "окей",
    "иди вперёд"
   ],
   "text": "двигай дальше, двигай дальше"
  },
  {
   "id": "x55_r6_052",
   "before": [
    "Чисто.",
    "Кухня чистая, иду в столовую.",
    "Бричь северную дверь."
   ],
   "text": "Ставь дефузер у стола."
  },
  {
   "id": "x55_stt_027",
   "before": [
    "граник в дверь"
   ],
   "text": "нет, в ту, что я отметил"
  },
  {
   "id": "x_r6_137",
   "before": [
    "Пробей люк зарядом."
   ],
   "text": "Подожди."
  },
  {
   "id": "x58_r6_026",
   "before": [
    "Эла на точке.",
    "Хардбрич готов.",
    "Подойди к офису."
   ],
   "text": "Заходи в него."
  },
  {
   "id": "x58_r6_057",
   "before": [
    "Иди к столу у лестницы.",
    "Один на верхнем этаже."
   ],
   "text": "Запрыгни на него."
  },
  {
   "id": "x59_stt_027",
   "before": [
    "смок во двор",
    "ещё раз задыми его",
    "проверь восточную дверь"
   ],
   "text": "не-не, западную"
  },
  {
   "id": "x55_stt_015",
   "before": [
    "закинь им гранату"
   ],
   "text": "э, вон туда"
  },
  {
   "id": "x55_r6_010",
   "before": [
    "Глушилку Мьюта сняли.",
    "Дым на главную дверь."
   ],
   "text": "Не, на ту, что у моего пина."
  },
  {
   "id": "x59_cs_029",
   "before": [
    "открывай огонь",
    "продолжай стрелять по двери",
    "проверь кухню"
   ],
   "text": "нет, вон там"
  },
  {
   "id": "x_cs_079",
   "before": [],
   "text": "продронь верхний этаж"
  },
  {
   "id": "x58_r6_020",
   "before": [
    "Гараж чистый.",
    "Мьют готов.",
    "Бандита последний раз видели в баре.",
    "Садись в машину."
   ],
   "text": "Вылезай."
  },
  {
   "id": "x59_stt_006",
   "before": [],
   "text": "спустись по красной лестнице и после этого стреляй вон туда"
  },
  {
   "id": "x59_cs_009",
   "before": [],
   "text": "давай к южной двери, потом флешку в комнату"
  },
  {
   "id": "x_r6_122",
   "before": [
    "Пушь в гараж."
   ],
   "text": "Отходи."
  },
  {
   "id": "x59_cs_026",
   "before": [
    "стреляй по окну",
    "ещё раз по нему",
    "иди к синей лестнице"
   ],
   "text": "не, к моей метке"
  },
  {
   "id": "x59_r6_022",
   "before": [],
   "text": "Пригнись и спрячься за чем-нибудь крепким."
  },
  {
   "id": "x_stt_119",
   "before": [
    "задыми главную дверь",
    "проверь крышу"
   ],
   "text": "э, сделай ещё раз"
  },
  {
   "id": "x55_stt_028",
   "before": [
    "ты иди проверь комнату"
   ],
   "text": "вот эту"
  },
  {
   "id": "x_r6_005",
   "before": [
    "Держи жёлтую лестницу."
   ],
   "text": "Кинь на неё смок."
  },
  {
   "id": "x58_cs_049",
   "before": [
    "один остался",
    "чекни ту комнату"
   ],
   "text": "следующую"
  },
  {
   "id": "x_stt_134",
   "before": [
    "держи красную лестницу"
   ],
   "text": "стой на моей метке"
  },
  {
   "id": "x58_stt_030",
   "before": [
    "двое наверху",
    "иди к северной двери",
    "найс"
   ],
   "text": "э, ближе"
  },
  {
   "id": "x_cs_110",
   "before": [
    "пробей восточную стену зарядом"
   ],
   "text": "открой западную дверь"
  },
  {
   "id": "x_cs_055",
   "before": [
    "флешку на главный по моей команде"
   ],
   "text": "давай, давай, давай"
  },
  {
   "id": "x59_cs_007",
   "before": [],
   "text": "залезь наверх по лестнице, запрыгни на ящики и перезарядись"
  },
  {
   "id": "x_r6_017",
   "before": [],
   "text": "Не, просто заходи."
  },
  {
   "id": "x58_cs_000",
   "before": [
    "красава",
    "эко раунд",
    "беги к тому грузовику"
   ],
   "text": "залезай в него, бро"
  },
  {
   "id": "x58_stt_004",
   "before": [
    "так, короче",
    "иди к тому ящику"
   ],
   "text": "залезь в него"
  },
  {
   "id": "x58_cs_053",
   "before": [
    "дым на главную дверь"
   ],
   "text": "ок, двигай дальше"
  },
  {
   "id": "x59_cs_022",
   "before": [],
   "text": "пригнись и спрячься за чем-нибудь, бро"
  },
  {
   "id": "x58_r6_007",
   "before": [
    "Роумер в гараже.",
    "Иди к южной двери.",
    "Осторожно, Капкан."
   ],
   "text": "Сначала задыми её."
  },
  {
   "id": "x58_stt_007",
   "before": [
    "красивый выстрел",
    "окей, иди на кухню"
   ],
   "text": "заходи в неё"
  },
  {
   "id": "x59_r6_001",
   "before": [
    "У Йегера АДС на лестнице, не доверяй ему."
   ],
   "text": "Сдвинься влево, потом присядь."
  },
  {
   "id": "x58_r6_052",
   "before": [
    "Дрон сбили.",
    "АДС Йегера на люке.",
    "Иди к синей лестнице.",
    "Найс.",
    "Один на кухне."
   ],
   "text": "Держи южное окно."
  },
  {
   "id": "x_cs_040",
   "before": [
    "молик в западное окно"
   ],
   "text": "задыми его"
  },
  {
   "id": "x_r6_059",
   "before": [],
   "text": "Двое на точке, один роумит наверху."
  },
  {
   "id": "x59_stt_014",
   "before": [
    "проверь подвал"
   ],
   "text": "окей, спустись по коричневой лестнице и смотри за южной дверью"
  },
  {
   "id": "x_r6_022",
   "before": [
    "Запусти дрон на кухню."
   ],
   "text": "Заходи после того, как зафлешишь её."
  },
  {
   "id": "x_r6_121",
   "before": [
    "Пробей восточную дверь зарядом."
   ],
   "text": "Не, западную."
  },
  {
   "id": "x_stt_041",
   "before": [
    "продронь гараж"
   ],
   "text": "ты пушь после того, как кинешь в него флешку"
  },
  {
   "id": "x59_r6_037",
   "before": [],
   "text": "Зажми красную лестницу и не давай им высунуться."
  },
  {
   "id": "x55_stt_011",
   "before": [
    "садись в машину"
   ],
   "text": "э, вылезай и возьми винтовку"
  },
  {
   "id": "x_r6_138",
   "before": [
    "Дым на красную лестницу.",
    "Смотри за северным окном."
   ],
   "text": "Закинь туда гранату."
  },
  {
   "id": "x_r6_031",
   "before": [
    "Иди к красной лестнице."
   ],
   "text": "Прикрой меня."
  },
  {
   "id": "x_stt_012",
   "before": [
    "держи главную дверь",
    "смок на красную лестницу"
   ],
   "text": "не стреляй, не стреляй"
  },
  {
   "id": "x_cs_122",
   "before": [
    "огонь по восточному окну"
   ],
   "text": "нет, зажми его"
  },
  {
   "id": "x59_r6_002",
   "before": [],
   "text": "Спустись по рампе в гараж, потом найди укрытие."
  },
  {
   "id": "x59_r6_015",
   "before": [],
   "text": "Иди налево мимо бара, а потом за мной."
  },
  {
   "id": "x58_cs_020",
   "before": [
    "эко",
    "садись в грузовик",
    "найс, мы рядом"
   ],
   "text": "выпрыгивай"
  },
  {
   "id": "x55_r6_022",
   "before": [
    "Хороший дрон.",
    "Один на лестнице, один в столовой.",
    "Флешку в дверь."
   ],
   "text": "В ту, что на моей метке."
  },
  {
   "id": "x_stt_056",
   "before": [
    "обходи слева"
   ],
   "text": "справа, в смысле"
  },
  {
   "id": "x59_cs_001",
   "before": [
    "красава, бро",
    "смотри за главной дверью"
   ],
   "text": "ок, сдвинься вправо, потом присядь"
  },
  {
   "id": "x55_stt_008",
   "before": [
    "бричь дверь"
   ],
   "text": "ту, что у моей метки"
  },
  {
   "id": "x58_r6_023",
   "before": [
    "Мьют на стене.",
    "Кинь дым на восточную дверь."
   ],
   "text": "Не, на мою метку."
  },
  {
   "id": "x59_cs_012",
   "before": [
    "перезарядись, бро"
   ],
   "text": "спустись по белым ступенькам, а потом держись рядом со мной"
  },
  {
   "id": "x59_cs_033",
   "before": [
    "флешку на кухню",
    "ещё раз флешани её",
    "флешку в коридор",
    "в укрытие"
   ],
   "text": "за машину"
  },
  {
   "id": "x_r6_127",
   "before": [
    "Открой главную дверь."
   ],
   "text": "Бричь люк."
  },
  {
   "id": "x_cs_099",
   "before": [
    "держи восточное окно"
   ],
   "text": "нет, флешани его"
  },
  {
   "id": "x58_cs_003",
   "before": [
    "там двое",
    "иди в подвал"
   ],
   "text": "и зачисти его"
  },
  {
   "id": "x_stt_082",
   "before": [
    "пробей северную стену зарядом"
   ],
   "text": "попробуй ещё раз, ещё раз"
  },
  {
   "id": "x55_r6_032",
   "before": [
    "Смотри за главной дверью."
   ],
   "text": "Не стреляй, пока они не пушнут."
  },
  {
   "id": "x58_cs_004",
   "before": [
    "иди к красной лестнице"
   ],
   "text": "смотри за ней"
  },
  {
   "id": "x_cs_081",
   "before": [
    "дрон в подвал"
   ],
   "text": "давай ещё раз"
  },
  {
   "id": "x_stt_111",
   "before": [
    "иди к двери гаража"
   ],
   "text": "открой её и потом заходи"
  },
  {
   "id": "x59_stt_023",
   "before": [
    "держи северную дверь"
   ],
   "text": "окей, иди флешани северную дверь"
  },
  {
   "id": "x_cs_027",
   "before": [
    "посмотри направо"
   ],
   "text": "нет, налево"
  },
  {
   "id": "x55_stt_059",
   "before": [
    "так, короче",
    "один в окне",
    "граник"
   ],
   "text": "э, в это окно"
  },
  {
   "id": "x_cs_023",
   "before": [
    "штурмуй гараж"
   ],
   "text": "отступай"
  },
  {
   "id": "x_stt_044",
   "before": [],
   "text": "э, отправь дрон на верхний этаж"
  },
  {
   "id": "x_r6_010",
   "before": [
    "Ропни к окну."
   ],
   "text": "К восточному."
  },
  {
   "id": "x59_r6_038",
   "before": [
    "Они ротейтятся через лобби."
   ],
   "text": "Смотри за северной дверью и не своди с неё глаз."
  },
  {
   "id": "x58_cs_011",
   "before": [
    "давай в подвал"
   ],
   "text": "сначала продронь его"
  },
  {
   "id": "x58_stt_029",
   "before": [
    "окей, чисто",
    "возвращайся ко мне"
   ],
   "text": "э, давай-давай, продолжай"
  },
  {
   "id": "x58_cs_056",
   "before": [
    "проверь подвал"
   ],
   "text": "иди вон туда"
  },
  {
   "id": "x_r6_046",
   "before": [],
   "text": "Держи другой угол."
  },
  {
   "id": "x_r6_042",
   "before": [
    "Проверь второй этаж."
   ],
   "text": "И верхний тоже."
  },
  {
   "id": "x59_r6_030",
   "before": [
    "Держи жёлтую лестницу.",
    "Я сказал, держи жёлтую лестницу.",
    "Перелезь через окно."
   ],
   "text": "Через восточное."
  },
  {
   "id": "x_cs_123",
   "before": [
    "кинь флешку в восточную дверь"
   ],
   "text": "вали их"
  },
  {
   "id": "x_r6_030",
   "before": [
    "Проверь гараж."
   ],
   "text": "Нет, продронь его."
  }
 ]
}