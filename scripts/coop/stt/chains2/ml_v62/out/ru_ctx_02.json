   "before": [
    "взорви западную дверь"
   ],
   "text": "давай ещё попытку, бро"
  },
  {
   "id": "x58_cs_041",
   "before": [
    "иди за мной"
   ],
   "text": "нет, жди здесь"
  },
  {
   "id": "x_stt_133",
   "before": [
    "спустись по верёвке на крышу"
   ],
   "text": "отмена, отмени это"
  },
  {
   "id": "x_stt_079",
   "before": [
    "открой люк"
   ],
   "text": "не-не, ты просто посмотри на него"
  },
  {
   "id": "x_cs_017",
   "before": [
    "флеш на мейн"
   ],
   "text": "ещё раз"
  },
  {
   "id": "x_r6_114",
   "before": [
    "Поставь дым на восточное окно."
   ],
   "text": "И на западное окно."
  },
  {
   "id": "x_cs_125",
   "before": [
    "гранату в восточное окно"
   ],
   "text": "нет, просто смотри за ним"
  },
  {
   "id": "x_stt_087",
   "before": [
    "закинь смок в подвал, а потом проверь его"
   ],
   "text": "то же самое с гаражом"
  },
  {
   "id": "x_cs_018",
   "before": [
    "граник в окно"
   ],
   "text": "в левое"
  },
  {
   "id": "x58_stt_034",
   "before": [
    "окей, за мной"
   ],
   "text": "ближе"
  },
  {
   "id": "x55_stt_017",
   "before": [
    "окей, найс",
    "брични западную дверь"
   ],
   "text": "ещё раз"
  },
  {
   "id": "x_r6_041",
   "before": [
    "Смок на лестницу."
   ],
   "text": "На вторую."
  },
  {
   "id": "x58_r6_050",
   "before": [
    "Камера Valk в столовой.",
    "Иди к белой лестнице."
   ],
   "text": "Ближе."
  },
  {
   "id": "x_cs_136",
   "before": [
    "флешку на кухню",
    "го, го"
   ],
   "text": "последний за диваном"
  },
  {
   "id": "x_cs_062",
   "before": [
    "держи угол"
   ],
   "text": "кстати, красная лестница чистая"
  },
  {
   "id": "x55_cs_059",
   "before": [
    "перелезь через то окно"
   ],
   "text": "давай ещё раз, чувак"
  },
  {
   "id": "x55_stt_058",
   "before": [
    "за мной",
    "окей, проверь подвал",
    "подави огнём восточное окно"
   ],
   "text": "ещё, ещё"
  },
  {
   "id": "x58_stt_038",
   "before": [
    "двое на кухне",
    "найс",
    "иди к моему пину"
   ],
   "text": "окей, попробуй ещё раз с правой стороны"
  },
  {
   "id": "x58_stt_017",
   "before": [
    "иди к машине"
   ],
   "text": "э, давай, поехали"
  },
  {
   "id": "x58_r6_045",
   "before": [
    "Kaid электризует.",
    "Пробей восточную стену."
   ],
   "text": "Ещё раз так же, по моей команде."
  },
  {
   "id": "x_stt_000",
   "before": [
    "флешку на кухню"
   ],
   "text": "не флешку, в смысле дым"
  },
  {
   "id": "x58_stt_046",
   "before": [
    "за мной",
    "гранату в южное окно"
   ],
   "text": "ещё в одно"
  },
  {
   "id": "x55_stt_035",
   "before": [
    "иди к северному окну",
    "смотри за северным окном",
    "двое слева"
   ],
   "text": "не стреляй, пока не подойдут ближе"
  },
  {
   "id": "x_r6_057",
   "before": [
    "Перелезь через западное окно."
   ],
   "text": "Нет, просто открой его."
  },
  {
   "id": "x_stt_125",
   "before": [
    "пробей западную дверь"
   ],
   "text": "открой южное окно"
  },
  {
   "id": "x55_r6_016",
   "before": [
    "Двигайся вперёд."
   ],
   "text": "К тому углу."
  },
  {
   "id": "x_r6_089",
   "before": [
    "Подави южное окно огнём."
   ],
   "text": "Поставь на него дым."
  },
  {
   "id": "x55_r6_042",
   "before": [
    "Брични северную дверь."
   ],
   "text": "Пока не взрывай, сначала продронь её."
  },
  {
   "id": "x_r6_011",
   "before": [
    "Кинь светошумовую на кухню."
   ],
   "text": "Кинь смок на западное окно."
  },
  {
   "id": "x59_stt_037",
   "before": [],
   "text": "ложись и, э, стреляй по западной двери"
  },
  {
   "id": "x_stt_046",
   "before": [
    "кинь дым к восточному окну"
   ],
   "text": "не-не, к западному"
  },
  {
   "id": "x_cs_025",
   "before": [
    "кинь гранату на кухню"
   ],
   "text": "первое"
  },
  {
   "id": "x59_stt_015",
   "before": [
    "найс",
    "они отходят",
    "э, продолжай смотреть за дверью"
   ],
   "text": "двигай на кухню, а потом перезарядись"
  },
  {
   "id": "x59_r6_031",
   "before": [
    "Флешку на лестницу.",
    "Ещё флешку на лестницу.",
    "Кинь дым."
   ],
   "text": "На северное окно."
  },
  {
   "id": "x58_cs_034",
   "before": [
    "найс",
    "смок на мид",
    "двое на А",
    "они ротейтятся",
    "подойди к белой лестнице"
   ],
   "text": "поближе"
  },
  {
   "id": "x59_cs_021",
   "before": [
    "они пушат",
    "по нам стреляют"
   ],
   "text": "добеги до грузовика и спрячься за ним"
  },
  {
   "id": "x58_stt_025",
   "before": [
    "найс",
    "вперёд"
   ],
   "text": "э, ещё вперёд"
  },
  {
   "id": "x55_cs_022",
   "before": [
    "гранату в окно"
   ],
   "text": "вот сюда, рядом, чувак"
  },
  {
   "id": "x58_r6_032",
   "before": [
    "Thermite на стене.",
    "Кухня чистая.",
    "Проверь подвал."
   ],
   "text": "Зачисти его."
  },
  {
   "id": "x_cs_108",
   "before": [
    "смок на мейн",
    "держи восточное окно"
   ],
   "text": "граник в него"
  },
  {
   "id": "x58_stt_042",
   "before": [
    "двое слева",
    "в укрытие"
   ],
   "text": "нет, иди со мной"
  },
  {
   "id": "x_stt_102",
   "before": [
    "поставь дым на главную дверь",
    "держи белую лестницу"
   ],
   "text": "нет, красную"
  },
  {
   "id": "x_stt_061",
   "before": [
    "разведай второй этаж"
   ],
   "text": "и крышу тоже"
  },
  {
   "id": "x55_stt_019",
   "before": [
    "э, за мной",
    "смотри за синей лестницей"
   ],
   "text": "не-не, за той дверью"
  },
  {
   "id": "x58_cs_055",
   "before": [
    "эко",
    "иди к красной лестнице"
   ],
   "text": "стой прямо здесь"
  },
  {
   "id": "x55_stt_026",
   "before": [
    "спрыгни вниз"
   ],
   "text": "окей, ещё раз"
  },
  {
   "id": "x58_cs_023",
   "before": [
    "иди вперёд"
   ],
   "text": "давай дальше"
  },
  {
   "id": "x55_r6_034",
   "before": [
    "Пробей восточную стену."
   ],
   "text": "Не надо."
  },
  {
   "id": "x55_cs_056",
   "before": [
    "найс",
    "проверь подвал"
   ],
   "text": "сходи за патронами, потом садись в машину"
  },
  {
   "id": "x_stt_067",
   "before": [
    "запусти дрон в подвал",
    "я не вижу"
   ],
   "text": "ещё раз, ещё раз"
  },
  {
   "id": "x_cs_131",
   "before": [
    "держи красную лестницу"
   ],
   "text": "иди туда"
  },
  {
   "id": "x_stt_114",
   "before": [
    "штурмуй кухню"
   ],
   "text": "отступай, отступай"
  },
  {
   "id": "x_stt_106",
   "before": [
    "кинь дымовую"
   ],
   "text": "на жёлтую лестницу"
  },
  {
   "id": "x55_r6_056",
   "before": [
    "Садись в машину.",
    "Они ротейтятся в гараж."
   ],
   "text": "Выпрыгивай и хватай дробовик."
  },
  {
   "id": "x59_r6_005",
   "before": [
    "Mira на кухне, сквозь неё не видно."
   ],
   "text": "Двигай вперёд к бару, потом граник на кухню."
  },
  {
   "id": "x_cs_038",
   "before": [
    "дым на мейн"
   ],
   "text": "смок был отстой"
  },
  {
   "id": "x59_r6_036",
   "before": [],
   "text": "Прекрати огонь, потом кинь дым на главную дверь."
  },
  {
   "id": "x_stt_003",
   "before": [
    "смок на главную дверь",
    "го, го, го"
   ],
   "text": "они идут из подвала"
  },
  {
   "id": "x58_r6_028",
   "before": [
    "Дрон запущен.",
    "Осталось двое.",
    "Kaid на люке.",
    "Переходи к северному окну."
   ],
   "text": "Двигайся дальше."
  },
  {
   "id": "x58_stt_031",
   "before": [
    "иди вправо"
   ],
   "text": "продолжай двигаться"
  },
  {
   "id": "x_stt_117",
   "before": [
    "иди к восточной стене"
   ],
   "text": "пробей зарядом ту стену"
  },
  {
   "id": "x59_stt_026",
   "before": [
    "э, граник на кухню",
    "гранату в коридор",
    "дуй к синей лестнице"
   ],
   "text": "э, нет, к красной"
  },
  {
   "id": "x_cs_051",
   "before": [
    "брични восточную дверь"
   ],
   "text": "забудь"
  },
  {
   "id": "x_r6_037",
   "before": [
    "Спрячься за столом."
   ],
   "text": "За диваном, в смысле."
  },
  {
   "id": "x_stt_088",
   "before": [
    "пробей восточную дверь"
   ],
   "text": "не-не, смок на западное окно"
  },
  {
   "id": "x59_cs_006",
   "before": [
    "за мной",
    "стоп"
   ],
   "text": "иди к восточному окну, потом смотри за красной лестницей"
  },
  {
   "id": "x55_stt_039",
   "before": [
    "иди за мной",
    "окей, тут всё"
   ],
   "text": "окей, прыгай в грузовик"
  },
  {
   "id": "x_r6_021",
   "before": [
    "Иди к красной лестнице.",
    "Гранату на кухню."
   ],
   "text": "Стоп."
  },
  {
   "id": "x59_stt_034",
   "before": [],
   "text": "пригнись и, э, поменяй магазин"
  },
  {
   "id": "x_stt_100",
   "before": [
    "открой западную дверь"
   ],
   "text": "окей, тогда брични её"
  },
  {
   "id": "x55_stt_041",
   "before": [
    "в укрытие"
   ],
   "text": "окей, не двигайся"
  },
  {
   "id": "x_r6_104",
   "before": [
    "Перелезь через окно."
   ],
   "text": "Через восточное."
  },
  {
   "id": "x_r6_066",
   "before": [
    "Иди к белой лестнице.",
    "Зажми южную дверь."
   ],
   "text": "Сорри, северную."
  },
  {
   "id": "x_r6_070",
   "before": [
    "Запусти дрон в подвал."
   ],
   "text": "Кинь светошумовую на кухню, потом зачисти её."
  },
  {
   "id": "x55_cs_005",
   "before": [
    "эко раунд",
    "за мной"
   ],
   "text": "иди найди броню, чувак"
  },
  {
   "id": "x_cs_084",
   "before": [
    "открой главную дверь"
   ],
   "text": "северную дверь тоже"
  },
  {
   "id": "x_r6_093",
   "before": [
    "Поставь дым на главную дверь.",
    "Проверь верхний этаж."
   ],
   "text": "Сделай это ещё раз."
  },
  {
   "id": "x55_r6_000",
   "before": [
    "Один остался, он на кухне.",
    "Гранату в западное окно."
   ],
   "text": "Ещё раз граник в него."
  },
  {
   "id": "x_stt_017",
   "before": [
    "иди к коричневой лестнице"
   ],
   "text": "пожалуйста, следи за белой лестницей"
  },
  {
   "id": "x_stt_004",
   "before": [],
   "text": "ставь бомбу, ставь бомбу"
  },
  {
   "id": "x55_stt_038",
   "before": [
    "проверь подвал",
    "окей, чисто",
    "смок на лестницу"
   ],
   "text": "на мой пин"
  },
  {
   "id": "x_r6_028",
   "before": [
    "Пробей северную стену.",
    "Чёрт, она укреплена."
   ],
   "text": "Держи красную лестницу."
  },
  {
   "id": "x59_cs_004",
   "before": [],
   "text": "беги к грузовику, запрыгни, а потом выпрыгни обратно"
  },
  {
   "id": "x_r6_067",
   "before": [
    "За мной.",
    "Смотри за дверью."
   ],
   "text": "За восточной."
  },
  {
   "id": "x_r6_015",
   "before": [
    "Продронь подвал.",
    "Открой северную дверь."
   ],
   "text": "Я имел в виду окно."
  },
  {
   "id": "x_stt_103",
   "before": [
    "держи главную дверь",
    "флешку на кухню"
   ],
   "text": "окей, теперь зачисти её"
  },
  {
   "id": "x55_stt_010",
   "before": [
    "за мной",
    "кинь смок"
   ],
   "text": "на мою метку"
  },
  {
   "id": "x55_r6_043",
   "before": [
    "Кинь флешку."
   ],
   "text": "Через то окно."
  },
  {
   "id": "x59_stt_002",
   "before": [],
   "text": "окей, залезь наверх по лестнице, потом глянь налево"
  },
  {
   "id": "x_cs_130",
   "before": [
    "прикрой меня"
   ],
   "text": "плантуй бомбу"
  },
  {
   "id": "x_cs_048",
   "before": [
    "держи мейн",
    "граник на кухню"
   ],
   "text": "и в гараж тоже"
  },
  {
   "id": "x55_r6_009",
   "before": [
    "Двое в баре.",
    "Открой дверь."
   ],
   "text": "Вон ту."
  },
  {
   "id": "x55_r6_037",
   "before": [
    "Пушь через мейн."
   ],
   "text": "Нет, не пушь. Сначала поставь на него дым."
  },
  {
   "id": "x_cs_042",
   "before": [
    "открой северную дверь"
   ],
   "text": "не, просто смотри за ней"
  },
  {
   "id": "x55_r6_047",
   "before": [],
   "text": "Возьми патроны, потом прыгай в грузовик."
  },
  {
   "id": "x_stt_051",
   "before": [
    "держи лестницу"
   ],
   "text": "э, синюю"
  },
  {
   "id": "x_stt_034",
   "before": [
    "иди к белой лестнице"
   ],
   "text": "а потом занимай там позицию"
  },
  {
   "id": "x_stt_022",
   "before": [
    "посмотри на диван"
   ],
   "text": "спрячься за ним"
  },
  {
   "id": "x58_stt_022",
   "before": [
    "за мной",
    "прыгай в машину"
   ],
   "text": "э, вылезай из неё"
  },
  {
   "id": "x_r6_051",
   "before": [
    "Брични восточную стену."
   ],
   "text": "Взорви люк."
  },
  {
   "id": "x58_stt_028",
   "before": [
    "проверь подвал",
    "спускайся по пандусу"
   ],
   "text": "ещё чуть-чуть"
  },
  {
   "id": "x_stt_122",
   "before": [
    "кинь флешку в гараж"
   ],
   "text": "кинь дым на главную дверь"
  },
  {
   "id": "x_stt_096",
   "before": [
    "иди к жёлтой лестнице"
   ],
   "text": "прикрывай, прикрывай меня"
  },
  {
   "id": "x58_cs_047",
   "before": [
    "смок на южное окно"
   ],
   "text": "теперь на другое"
  },
  {
   "id": "x59_cs_023",
   "before": [
    "они на кухне"
   ],
   "text": "иди кинь флешку на кухню"
  },
  {
   "id": "x55_r6_002",
   "before": [
    "Держись рядом.",
    "Меняем план, я захожу с фланга один."
   ],
   "text": "Не иди за мной."
  },
  {
   "id": "x55_r6_031",
   "before": [
    "Закинь гранату в северное окно."
   ],
   "text": "Пробуй ещё раз."
  },
  {
   "id": "x_stt_110",
   "before": [],
   "text": "да, давай"
  },
  {
   "id": "x_cs_074",
   "before": [
    "чекни внизу"
   ],
   "text": "наверху, не внизу"
  },
  {
   "id": "x_cs_075",
   "before": [
    "держи синюю лестницу",
    "огонь"
   ],
   "text": "по восточному окну"
  },
  {
   "id": "x_cs_060",
   "before": [
    "иди к восточной стене"
   ],
   "text": "брични её и заходи"
  },
  {
   "id": "x55_cs_015",
   "before": [
    "он на ваншоте",
    "смотри за белой лестницей"
   ],
   "text": "жди тут"
  },
  {
   "id": "x_r6_080",
   "before": [
    "Пробей восточную стену по моей команде."
   ],
   "text": "Давай!"
  },
  {
   "id": "x_r6_075",
   "before": [
    "Разведай подвал."
   ],
   "text": "И верхний этаж тоже."
  },
  {
   "id": "x55_stt_029",
   "before": [
    "прикрой меня",
    "окей, я захожу"
   ],
   "text": "не ходи за мной"
  },
  {
   "id": "x59_cs_013",
   "before": [],
   "text": "бро, иди к моему пину, ложись"
  },
  {
   "id": "x55_stt_031",
   "before": [
    "э, дым"
   ],
   "text": "на ту дверь, вон там"
  },
  {
   "id": "x55_r6_025",
   "before": [
    "Смотри за южным окном."
   ],
   "text": "Иди туда."
  },
  {
   "id": "x_cs_029",
   "before": [
    "флеш на мейн",
    "смок на восточную дверь"
   ],
   "text": "смок сюда"
  },
  {
   "id": "x55_stt_024",
   "before": [
    "двое слева",
    "окей",
    "окей, иди к двери"
   ],
   "text": "к той"
  },
  {
   "id": "x_cs_033",
   "before": [
    "флешку на мейн"
   ],
   "text": "давай лучше дым"
  },
  {
   "id": "x59_cs_002",
   "before": [],
   "text": "беги к моей метке и вали их"
  },
  {
   "id": "x_r6_035",
   "before": [
    "Смок на главную дверь."
   ],
   "text": "Стой на моей метке."
  },
  {
   "id": "x59_r6_019",
   "before": [
    "Двое в баре, оба сидят на точке."
   ],
   "text": "Рашь в бар и зачисти его."
  },
  {
   "id": "x_r6_076",
   "before": [
    "Флешку на главную дверь."
   ],
   "text": "Не флешку, кинь на неё дым."
  },
  {
   "id": "x55_stt_021",
   "before": [
    "гранату в северное окно"
   ],
   "text": "ещё раз гранату в него"
  },
  {
   "id": "x_cs_089",
   "before": [
    "держи синюю лестницу",
    "проверь дверь"
   ],
   "text": "левую"
  },
  {
   "id": "x55_cs_034",
   "before": [
    "кинь молик на мою метку"
   ],
   "text": "не надо"
  },
  {
   "id": "x_stt_029",
   "before": [
    "зачисти подвал"
   ],
   "text": "окей, возвращайся сюда"
  },
  {
   "id": "x_cs_006",
   "before": [
    "держи восточную дверь"
   ],
   "text": "дым на западное окно, потом переходи на мейн"
  },
  {
   "id": "x58_cs_014",
   "before": [
    "найс",
    "иди к машине"
   ],
   "text": "запрыгивай"
  },
  {
   "id": "x_cs_071",
   "before": [
    "флешку в гараж"
   ],
   "text": "и на кухню одну кинь"
  },
  {
   "id": "x59_r6_016",
   "before": [
    "Они держат мейн с лестницы."
   ],
   "text": "Поднимайся по красной лестнице, присядь и смотри за главной дверью."
  },
  {
   "id": "x59_stt_012",
   "before": [
    "присядь"
   ],
   "text": "э, пройди чуть вперёд, потом встань"
  },
  {
   "id": "x_r6_001",
   "before": [
    "Продронь подвал."
   ],
   "text": "Отбой."
  },
  {
   "id": "x58_r6_001",
   "before": [
    "Флешку на северную дверь."
   ],
   "text": "Нет, дым на лестницу."
  },
  {
   "id": "x58_r6_036",
   "before": [
    "Найс, минус один.",
    "Дуй к жёлтой лестнице.",
    "Они идут снизу."
   ],
   "text": "Держи её."
  },
  {
   "id": "x_cs_066",
   "before": [
    "флешку в гараж"
   ],
   "text": "а лучше кинь в него молик"
  },
  {
   "id": "x58_cs_021",
   "before": [
    "эко",
    "прыгай в тачку"
   ],
   "text": "вылезай, вылезай"
  },
  {
   "id": "x_r6_086",
   "before": [
    "Держи главную дверь.",
    "Кинь светошумовую в гараж."
   ],
   "text": "Теперь зачисти его."
  },
  {
   "id": "x_r6_123",
   "before": [
    "Продронь подвал.",
    "Я ничего не вижу."
   ],
   "text": "Ещё раз."
  },
  {
   "id": "x58_r6_018",
   "before": [
    "Bandit мёртв.",
    "Открой люк."
   ],
   "text": "Прыгай через него вниз."
  }
 ]
}
