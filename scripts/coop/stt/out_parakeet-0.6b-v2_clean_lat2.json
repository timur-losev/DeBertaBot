{"summary": {"engine": "parakeet-0.6b-v2", "cond": "clean", "n": 60, "load_s": 1.9779421999701299, "rss_mb": 705.8671875, "peak_mb": 767.86328125, "cores_busy": 2.5158351157909546, "audio_s_avg": 2.3366854166666666, "full_ms_med": 201.81239998782985, "full_ms_p95": 274.2992799554486, "tail_ms_med": null, "tail_ms_p95": null, "rtf_streamed": null, "same_text_streamed": null, "threads": "2"}, "rows": [{"id": "r6_000", "text": "Clip onto the roof edge and go inverted on bedroom.", "full_ms": 266.8219999759458, "audio_s": 3.13}, {"id": "r6_001", "text": "Go wide and hit them off their side while I bait front.", "full_ms": 260.0459000095725, "audio_s": 3.07}, {"id": "r6_002", "text": "What op are you even running?", "full_ms": 181.25600001076236, "audio_s": 1.970625}, {"id": "r6_003", "text": "Drone the other room first.", "full_ms": 186.42209999961779, "audio_s": 2.075}, {"id": "r6_004", "text": "Split the angles, I take hatch, you take the other one.", "full_ms": 334.1736999573186, "audio_s": 4.055}, {"id": "r6_005", "text": "Get on the rope and climb up to roof.", "full_ms": 206.08470001025125, "audio_s": 2.36675}, {"id": "r6_006", "text": "On my mark, drop down the rope.", "full_ms": 227.0480000297539, "audio_s": 2.606875}, {"id": "r6_007", "text": "Block their sighty line with a smoke.", "full_ms": 212.45759999146685, "audio_s": 2.4}, {"id": "r6_008", "text": "Hop on the bomb and stick the diffuse.", "full_ms": 212.60159998200834, "audio_s": 2.433875}, {"id": "r6_009", "text": "Bro how did he hear me through the floor?", "full_ms": 212.41569996345788, "audio_s": 2.465}, {"id": "r6_010", "text": "Disengage and reset.", "full_ms": 168.7345000100322, "audio_s": 1.875}, {"id": "r6_011", "text": "Take the long way through my ping and pinch them.", "full_ms": 226.82500001974404, "audio_s": 2.60475}, {"id": "r6_012", "text": "Come get me, I'm bleeding out.", "full_ms": 215.6328999553807, "audio_s": 2.49}, {"id": "r6_013", "text": "Send it.", "full_ms": 122.36069998471066, "audio_s": 1.265}, {"id": "r6_014", "text": "Smash the glass and jump through.", "full_ms": 200.20519994432107, "audio_s": 2.28075}, {"id": "r6_015", "text": "Get out of there, it's a trap.", "full_ms": 212.36300002783537, "audio_s": 2.475}, {"id": "r6_016", "text": "Pre-aim the window by my ping and don't peek off it.", "full_ms": 255.8837999822572, "audio_s": 3.02}, {"id": "r6_017", "text": "Overwatch me while I'm droning.", "full_ms": 207.91519997874275, "audio_s": 2.177}, {"id": "r6_018", "text": "Throw a stunt through the doorway.", "full_ms": 190.57879998581484, "audio_s": 2.095}, {"id": "r6_019", "text": "Slap a charge on the barricade.", "full_ms": 200.36760001676157, "audio_s": 2.25}, {"id": "r6_020", "text": "This map is so bad for attack.", "full_ms": 197.93320004828274, "audio_s": 2.28075}, {"id": "r6_021", "text": "Take the other stairs up.", "full_ms": 169.32659997837618, "audio_s": 1.895}, {"id": "r6_022", "text": "Blow the hatch open.", "full_ms": 159.27589999046177, "audio_s": 1.69}, {"id": "r6_023", "text": "Don't push yet, not ready.", "full_ms": 195.21450001047924, "audio_s": 2.190875}, {"id": "r6_024", "text": "Cook one and toss it in.", "full_ms": 179.80829998850822, "audio_s": 1.95}, {"id": "r6_025", "text": "Roll a chem into kitchen and ID the ops.", "full_ms": 231.72699997667223, "audio_s": 2.72}, {"id": "r6_026", "text": "Res me please.", "full_ms": 148.86320004006848, "audio_s": 1.56175}, {"id": "r6_027", "text": "Tap the diffuser, I got you.", "full_ms": 215.026099991519, "audio_s": 2.555}, {"id": "r6_028", "text": "You anchor, freeze where you are.", "full_ms": 216.91670001018792, "audio_s": 2.52}, {"id": "r6_029", "text": "Tail me, we're rushing this together.", "full_ms": 215.17430001404136, "audio_s": 2.5365}, {"id": "r6_030", "text": "Bang the doorway then entry with me.", "full_ms": 203.0942999990657, "audio_s": 2.39}, {"id": "r6_031", "text": "I'm on this angle, you cover whatever I'm not looking at.", "full_ms": 299.0362999844365, "audio_s": 3.625}, {"id": "r6_032", "text": "They rotated through the bedroom wall.", "full_ms": 204.59290000144392, "audio_s": 2.35675}, {"id": "r6_033", "text": "Toss a bang in there.", "full_ms": 159.62910000234842, "audio_s": 1.725}, {"id": "r6_034", "text": "Vault into the room off my marker.", "full_ms": 200.530499976594, "audio_s": 2.265}, {"id": "r6_035", "text": "Cover default plant with smoke, glass is watching.", "full_ms": 275.5453000427224, "audio_s": 3.350375}, {"id": "r6_036", "text": "Smoke the doorway.", "full_ms": 149.21719999983907, "audio_s": 1.59}, {"id": "r6_037", "text": "Smoke the second door, not the one I'm at.", "full_ms": 261.4029999822378, "audio_s": 3.115}, {"id": "r6_038", "text": "Hang on a sec, don't do anything.", "full_ms": 216.4290999644436, "audio_s": 2.532625}, {"id": "r6_039", "text": "Blind the room for me.", "full_ms": 159.25850003259256, "audio_s": 1.741875}, {"id": "r6_040", "text": "Hold main door, anyone swings you drop M.", "full_ms": 274.2336999508552, "audio_s": 3.255}, {"id": "r6_041", "text": "Wait for my call, then smoke the door.", "full_ms": 226.74500005086884, "audio_s": 2.636375}, {"id": "r6_042", "text": "Burn them out with the molly under the stairs.", "full_ms": 224.88470003008842, "audio_s": 2.605}, {"id": "r6_043", "text": "When I yell go, loop round the back.", "full_ms": 231.03320004884154, "audio_s": 2.65}, {"id": "r6_044", "text": "Flash when I call it.", "full_ms": 157.96709997812286, "audio_s": 1.7365}, {"id": "r6_045", "text": "Flash the opposite doorway.", "full_ms": 187.84329999471083, "audio_s": 2.1}, {"id": "r6_046", "text": "Be ready to trade me when I swing.", "full_ms": 193.2982000289485, "audio_s": 2.19}, {"id": "r6_047", "text": "I'm down, pick me up.", "full_ms": 183.85790003230795, "audio_s": 2.00725}, {"id": "r6_048", "text": "Rotate over to where I marked.", "full_ms": 194.02130000526085, "audio_s": 2.23}, {"id": "r6_049", "text": "Drone me in before we commit.", "full_ms": 183.92630002927035, "audio_s": 2.05}, {"id": "r6_050", "text": "Bandit tricking the reinforce on main wall.", "full_ms": 232.64569998718798, "audio_s": 2.676875}, {"id": "r6_051", "text": "Breach that wall on my go.", "full_ms": 180.13489997247234, "audio_s": 1.995}, {"id": "r6_052", "text": "Voc cam top upstairs.", "full_ms": 184.32970001595095, "audio_s": 2.02}, {"id": "r6_053", "text": "Hard breach that wall.", "full_ms": 159.0692000463605, "audio_s": 1.697125}, {"id": "r6_054", "text": "Keep your crosshair on the long hallway.", "full_ms": 213.86550000170246, "audio_s": 2.54}, {"id": "r6_055", "text": "Nade that room.", "full_ms": 135.90019999537617, "audio_s": 1.395}, {"id": "r6_056", "text": "On 3Wi entry.", "full_ms": 149.65929999016225, "audio_s": 1.5845}, {"id": "r6_057", "text": "I got left door, you hold the right one.", "full_ms": 248.56069998349994, "audio_s": 2.946875}, {"id": "r6_058", "text": "Drop a cloud so we can cross.", "full_ms": 200.10949997231364, "audio_s": 2.285}, {"id": "r6_059", "text": "Go in through the other window.", "full_ms": 167.25050000241026, "audio_s": 1.9035}]}