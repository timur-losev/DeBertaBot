{"summary": {"engine": "parakeet-0.6b-v2", "cond": "clean", "n": 60, "load_s": 1.8730989000177942, "rss_mb": 707.0, "peak_mb": 769.3828125, "cores_busy": 6.141179725907005, "audio_s_avg": 2.3366854166666666, "full_ms_med": 144.98760001151823, "full_ms_p95": 186.36456000967883, "tail_ms_med": null, "tail_ms_p95": null, "rtf_streamed": null, "same_text_streamed": null, "threads": "4"}, "rows": [{"id": "r6_000", "text": "Clip onto the roof edge and go inverted on bedroom.", "full_ms": 182.26380000123754, "audio_s": 3.13}, {"id": "r6_001", "text": "Go wide and hit them off their side while I bait front.", "full_ms": 180.43790000956506, "audio_s": 3.07}, {"id": "r6_002", "text": "What op are you even running?", "full_ms": 126.95650005480275, "audio_s": 1.970625}, {"id": "r6_003", "text": "Drone the other room first.", "full_ms": 131.24459999380633, "audio_s": 2.075}, {"id": "r6_004", "text": "Split the angles, I take hatch, you take the other one.", "full_ms": 233.1658999901265, "audio_s": 4.055}, {"id": "r6_005", "text": "Get on the rope and climb up to roof.", "full_ms": 150.3136000246741, "audio_s": 2.36675}, {"id": "r6_006", "text": "On my mark, drop down the rope.", "full_ms": 154.24959996016696, "audio_s": 2.606875}, {"id": "r6_007", "text": "Block their sighty line with a smoke.", "full_ms": 178.6335000069812, "audio_s": 2.4}, {"id": "r6_008", "text": "Hop on the bomb and stick the diffuse.", "full_ms": 149.95979995001107, "audio_s": 2.433875}, {"id": "r6_009", "text": "Bro how did he hear me through the floor?", "full_ms": 154.1639999486506, "audio_s": 2.465}, {"id": "r6_010", "text": "Disengage and reset.", "full_ms": 118.07529994985089, "audio_s": 1.875}, {"id": "r6_011", "text": "Take the long way through my ping and pinch them.", "full_ms": 162.09220001474023, "audio_s": 2.60475}, {"id": "r6_012", "text": "Come get me, I'm bleeding out.", "full_ms": 158.59140001703054, "audio_s": 2.49}, {"id": "r6_013", "text": "Send it.", "full_ms": 103.58819999964908, "audio_s": 1.265}, {"id": "r6_014", "text": "Smash the glass and jump through.", "full_ms": 146.47519995924085, "audio_s": 2.28075}, {"id": "r6_015", "text": "Get out of there, it's a trap.", "full_ms": 145.590300031472, "audio_s": 2.475}, {"id": "r6_016", "text": "Pre-aim the window by my ping and don't peek off it.", "full_ms": 182.04829999012873, "audio_s": 3.02}, {"id": "r6_017", "text": "Overwatch me while I'm droning.", "full_ms": 135.604000010062, "audio_s": 2.177}, {"id": "r6_018", "text": "Throw a stunt through the doorway.", "full_ms": 138.08029994834214, "audio_s": 2.095}, {"id": "r6_019", "text": "Slap a charge on the barricade.", "full_ms": 146.1789000313729, "audio_s": 2.25}, {"id": "r6_020", "text": "This map is so bad for attack.", "full_ms": 147.50720001757145, "audio_s": 2.28075}, {"id": "r6_021", "text": "Take the other stairs up.", "full_ms": 126.51459994958714, "audio_s": 1.895}, {"id": "r6_022", "text": "Blow the hatch open.", "full_ms": 119.66769996797666, "audio_s": 1.69}, {"id": "r6_023", "text": "Don't push yet, not ready.", "full_ms": 144.6667000418529, "audio_s": 2.190875}, {"id": "r6_024", "text": "Cook one and toss it in.", "full_ms": 132.09190004272386, "audio_s": 1.95}, {"id": "r6_025", "text": "Roll a chem into kitchen and ID the ops.", "full_ms": 165.05740000866354, "audio_s": 2.72}, {"id": "r6_026", "text": "Res me please.", "full_ms": 113.92989999148995, "audio_s": 1.56175}, {"id": "r6_027", "text": "Tap the diffuser, I got you.", "full_ms": 148.5435999929905, "audio_s": 2.555}, {"id": "r6_028", "text": "You anchor, freeze where you are.", "full_ms": 147.22470002016053, "audio_s": 2.52}, {"id": "r6_029", "text": "Tail me, we're rushing this together.", "full_ms": 145.63990000169724, "audio_s": 2.5365}, {"id": "r6_030", "text": "Bang the doorway then entry with me.", "full_ms": 142.03039999119937, "audio_s": 2.39}, {"id": "r6_031", "text": "I'm on this angle, you cover whatever I'm not looking at.", "full_ms": 201.45619998220354, "audio_s": 3.625}, {"id": "r6_032", "text": "They rotated through the bedroom wall.", "full_ms": 140.04570001270622, "audio_s": 2.35675}, {"id": "r6_033", "text": "Toss a bang in there.", "full_ms": 114.59210002794862, "audio_s": 1.725}, {"id": "r6_034", "text": "Vault into the room off my marker.", "full_ms": 141.002899967134, "audio_s": 2.265}, {"id": "r6_035", "text": "Cover default plant with smoke, glass is watching.", "full_ms": 186.26310001127422, "audio_s": 3.350375}, {"id": "r6_036", "text": "Smoke the doorway.", "full_ms": 107.49279998708516, "audio_s": 1.59}, {"id": "r6_037", "text": "Smoke the second door, not the one I'm at.", "full_ms": 179.99960004817694, "audio_s": 3.115}, {"id": "r6_038", "text": "Hang on a sec, don't do anything.", "full_ms": 145.30849998118356, "audio_s": 2.532625}, {"id": "r6_039", "text": "Blind the room for me.", "full_ms": 112.56320000393316, "audio_s": 1.741875}, {"id": "r6_040", "text": "Hold main door, anyone swings you drop M.", "full_ms": 188.29229997936636, "audio_s": 3.255}, {"id": "r6_041", "text": "Wait for my call, then smoke the door.", "full_ms": 159.19119998579845, "audio_s": 2.636375}, {"id": "r6_042", "text": "Burn them out with the molly under the stairs.", "full_ms": 156.10970003763214, "audio_s": 2.605}, {"id": "r6_043", "text": "When I yell go, loop round the back.", "full_ms": 160.69549997337162, "audio_s": 2.65}, {"id": "r6_044", "text": "Flash when I call it.", "full_ms": 108.86149998987094, "audio_s": 1.7365}, {"id": "r6_045", "text": "Flash the opposite doorway.", "full_ms": 129.0455000125803, "audio_s": 2.1}, {"id": "r6_046", "text": "Be ready to trade me when I swing.", "full_ms": 132.8479999792762, "audio_s": 2.19}, {"id": "r6_047", "text": "I'm down, pick me up.", "full_ms": 139.3767999834381, "audio_s": 2.00725}, {"id": "r6_048", "text": "Rotate over to where I marked.", "full_ms": 164.69830001005903, "audio_s": 2.23}, {"id": "r6_049", "text": "Drone me in before we commit.", "full_ms": 131.58710004063323, "audio_s": 2.05}, {"id": "r6_050", "text": "Bandit tricking the reinforce on main wall.", "full_ms": 162.14800003217533, "audio_s": 2.676875}, {"id": "r6_051", "text": "Breach that wall on my go.", "full_ms": 127.62539996765554, "audio_s": 1.995}, {"id": "r6_052", "text": "Voc cam top upstairs.", "full_ms": 135.22489997558296, "audio_s": 2.02}, {"id": "r6_053", "text": "Hard breach that wall.", "full_ms": 115.95830001169816, "audio_s": 1.697125}, {"id": "r6_054", "text": "Keep your crosshair on the long hallway.", "full_ms": 144.51279997592792, "audio_s": 2.54}, {"id": "r6_055", "text": "Nade that room.", "full_ms": 99.03529996518046, "audio_s": 1.395}, {"id": "r6_056", "text": "On 3Wi entry.", "full_ms": 103.54859998915344, "audio_s": 1.5845}, {"id": "r6_057", "text": "I got left door, you hold the right one.", "full_ms": 167.42860001977533, "audio_s": 2.946875}, {"id": "r6_058", "text": "Drop a cloud so we can cross.", "full_ms": 138.1880000117235, "audio_s": 2.285}, {"id": "r6_059", "text": "Go in through the other window.", "full_ms": 116.0714000579901, "audio_s": 1.9035}]}