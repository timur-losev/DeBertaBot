{"summary": {"engine": "whisper-tiny.en", "cond": "clean", "n": 60, "load_s": 0.5470308000221848, "rss_mb": 221.546875, "peak_mb": 289.5390625, "cores_busy": 0.9999580550099176, "audio_s_avg": 2.3366854166666666, "full_ms_med": 246.9035999965854, "full_ms_p95": 330.56943501869677, "tail_ms_med": null, "tail_ms_p95": null, "rtf_streamed": null, "same_text_streamed": null, "threads": "1"}, "rows": [{"id": "r6_000", "text": "Clip onto the roof edge and go invert it on bedroom.", "full_ms": 329.3355000205338, "audio_s": 3.13}, {"id": "r6_001", "text": "Go white and hit them off their side while I bait front.", "full_ms": 328.5891000414267, "audio_s": 3.07}, {"id": "r6_002", "text": "What up are you even running?", "full_ms": 222.60779998032376, "audio_s": 1.970625}, {"id": "r6_003", "text": "Drone the other room first.", "full_ms": 213.3711000205949, "audio_s": 2.075}, {"id": "r6_004", "text": "Split the angles, I take hatch, you take the other one.", "full_ms": 372.7824999950826, "audio_s": 4.055}, {"id": "r6_005", "text": "Get on the rope and climb up to roof.", "full_ms": 271.06209995690733, "audio_s": 2.36675}, {"id": "r6_006", "text": "On my mark, drop down the rope.", "full_ms": 265.91209997422993, "audio_s": 2.606875}, {"id": "r6_007", "text": "block their sighty line with a smoke", "full_ms": 246.2107000174001, "audio_s": 2.4}, {"id": "r6_008", "text": "hop on the bomb and stick the diffuse.", "full_ms": 259.6351999673061, "audio_s": 2.433875}, {"id": "r6_009", "text": "Bro how did he hear me through the floor?", "full_ms": 272.24640001077205, "audio_s": 2.465}, {"id": "r6_010", "text": "Disengage and Reset.", "full_ms": 207.6239999732934, "audio_s": 1.875}, {"id": "r6_011", "text": "Take the long way through my ping and pinch them.", "full_ms": 290.33039999194443, "audio_s": 2.60475}, {"id": "r6_012", "text": "Come get me, I'm bleeding out.", "full_ms": 261.5628999774344, "audio_s": 2.49}, {"id": "r6_013", "text": "Send it. Send it. Send", "full_ms": 207.9350000130944, "audio_s": 1.265}, {"id": "r6_014", "text": "Smash the glass and jump through.", "full_ms": 235.07499997504056, "audio_s": 2.28075}, {"id": "r6_015", "text": "Get out of there, it's a trap.", "full_ms": 272.86010002717376, "audio_s": 2.475}, {"id": "r6_016", "text": "Pre-aim the window by my ping and don't peek off it.", "full_ms": 354.01419998379424, "audio_s": 3.02}, {"id": "r6_017", "text": "Overwatch me while I'm droning.", "full_ms": 253.02669999655336, "audio_s": 2.177}, {"id": "r6_018", "text": "Throw a stun through the doorway.", "full_ms": 226.69009998207912, "audio_s": 2.095}, {"id": "r6_019", "text": "Slap a charge on the barricade.", "full_ms": 255.84239995805547, "audio_s": 2.25}, {"id": "r6_020", "text": "This map is so bad for attack.", "full_ms": 243.66909998934716, "audio_s": 2.28075}, {"id": "r6_021", "text": "Take the other stairs up.", "full_ms": 208.42999999877065, "audio_s": 1.895}, {"id": "r6_022", "text": "Blow the hatch open.", "full_ms": 190.5352000030689, "audio_s": 1.69}, {"id": "r6_023", "text": "Don't push yet, not ready.", "full_ms": 241.71780003234744, "audio_s": 2.190875}, {"id": "r6_024", "text": "Cook one and toss it in.", "full_ms": 224.30369997164235, "audio_s": 1.95}, {"id": "r6_025", "text": "Roll a Cam into Kitchen and ID the Ops.", "full_ms": 282.464699994307, "audio_s": 2.72}, {"id": "r6_026", "text": "Res me, please.", "full_ms": 188.90820001251996, "audio_s": 1.56175}, {"id": "r6_027", "text": "Tap the diffuser, I got you.", "full_ms": 263.61279998673126, "audio_s": 2.555}, {"id": "r6_028", "text": "You anchor, freeze where you are.", "full_ms": 251.5331000322476, "audio_s": 2.52}, {"id": "r6_029", "text": "Tell me, we're rushing this together.", "full_ms": 262.87100004265085, "audio_s": 2.5365}, {"id": "r6_030", "text": "Bang the doorway then entry with me.", "full_ms": 247.5964999757707, "audio_s": 2.39}, {"id": "r6_031", "text": "I'm on this angle. You cover whatever I'm not looking at.", "full_ms": 370.36519998218864, "audio_s": 3.625}, {"id": "r6_032", "text": "They rotated through the bedroom wall.", "full_ms": 233.92570001306012, "audio_s": 2.35675}, {"id": "r6_033", "text": "Toss a bang in there.", "full_ms": 216.52800001902506, "audio_s": 1.725}, {"id": "r6_034", "text": "Vault into the room off my marker.", "full_ms": 242.59979999624193, "audio_s": 2.265}, {"id": "r6_035", "text": "Cover default plant with smoke. Glaze is watching.", "full_ms": 311.35050003649667, "audio_s": 3.350375}, {"id": "r6_036", "text": "Smoke the doorway.", "full_ms": 175.5125999916345, "audio_s": 1.59}, {"id": "r6_037", "text": "Smoke the second door, not the one I'm hit.", "full_ms": 315.27980003738776, "audio_s": 3.115}, {"id": "r6_038", "text": "Hang on a sec, don't do anything.", "full_ms": 275.6400000071153, "audio_s": 2.532625}, {"id": "r6_039", "text": "Blind the room for me.", "full_ms": 205.26539999991655, "audio_s": 1.741875}, {"id": "r6_040", "text": "Hold main door, anyone swings you drop M.", "full_ms": 295.43560004094616, "audio_s": 3.255}, {"id": "r6_041", "text": "Wait for my call, then smoke the door.", "full_ms": 276.58180001890287, "audio_s": 2.636375}, {"id": "r6_042", "text": "Burn them out with a molly under the stairs.", "full_ms": 289.0629000030458, "audio_s": 2.605}, {"id": "r6_043", "text": "When I Y'L go, loop round the back.", "full_ms": 303.5435000201687, "audio_s": 2.65}, {"id": "r6_044", "text": "Flash when I call it.", "full_ms": 203.54560000123456, "audio_s": 1.7365}, {"id": "r6_045", "text": "Flash the opposite doorway.", "full_ms": 200.54079999681562, "audio_s": 2.1}, {"id": "r6_046", "text": "Be ready to trade me when I swing.", "full_ms": 252.2597000352107, "audio_s": 2.19}, {"id": "r6_047", "text": "I'm down. Pick me up.", "full_ms": 237.01169999549165, "audio_s": 2.00725}, {"id": "r6_048", "text": "Rotate over to where I marked.", "full_ms": 241.69669998809695, "audio_s": 2.23}, {"id": "r6_049", "text": "drone me in before we commit", "full_ms": 211.3946999888867, "audio_s": 2.05}, {"id": "r6_050", "text": "Bandit tricking the reinforced on main wall.", "full_ms": 278.64360000239685, "audio_s": 2.676875}, {"id": "r6_051", "text": "breach that wall on my go.", "full_ms": 223.78880000906065, "audio_s": 1.995}, {"id": "r6_052", "text": "Vocum top of stairs", "full_ms": 211.61120000761002, "audio_s": 2.02}, {"id": "r6_053", "text": "Hard breach that wall.", "full_ms": 190.5160999740474, "audio_s": 1.697125}, {"id": "r6_054", "text": "Keep your crosshair on the long hallway.", "full_ms": 266.0702000139281, "audio_s": 2.54}, {"id": "r6_055", "text": "Nade that room.", "full_ms": 184.81649999739602, "audio_s": 1.395}, {"id": "r6_056", "text": "on 3-way entry.", "full_ms": 200.0162999611348, "audio_s": 1.5845}, {"id": "r6_057", "text": "I got left door, you hold the right one.", "full_ms": 296.6671999893151, "audio_s": 2.946875}, {"id": "r6_058", "text": "Drop a cloud so we can cross.", "full_ms": 241.67409999063239, "audio_s": 2.285}, {"id": "r6_059", "text": "Go in through the other window.", "full_ms": 220.39779997430742, "audio_s": 1.9035}]}