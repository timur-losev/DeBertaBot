[
  {"id": "r6v5_000", "text": "Take out the anchor, however you want to do it.", "intent": "ATTACK", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "attack"},
  {"id": "r6v5_001", "text": "Roamer's on you, engage him, he's all yours.", "intent": "ATTACK", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "attack"},
  {"id": "r6v5_002", "text": "On my go, take those two out, your call on how.", "intent": "ATTACK", "timing": "on_signal", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "attack"},
  {"id": "r6v5_003", "text": "Attack basement and kill whoever is anchoring it.", "intent": "ATTACK", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": "basement", "direction": null, "unknown_modifier": false}, "kind": "attack"},
  {"id": "r6v5_004", "text": "Engage to your left, there's a lurker, take him out.", "intent": "ATTACK", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": "left", "unknown_modifier": false}, "kind": "attack"},
  {"id": "r6v5_005", "text": "He's lit, low HP, go finish him off.", "intent": "ATTACK", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "attack"},
  {"id": "r6v5_006", "text": "Kill their last defender, I don't care how you do it.", "intent": "ATTACK", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "attack"},
  {"id": "r6v5_007", "text": "Attack them, we're running out of time.", "intent": "ATTACK", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "attack"},

  {"id": "r6v5_008", "text": "You're cleared hot, shoot anything that peeks.", "intent": "OPEN_FIRE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "open_fire"},
  {"id": "r6v5_009", "text": "Start blasting, they already know we're here.", "intent": "OPEN_FIRE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "open_fire"},
  {"id": "r6v5_010", "text": "On my mark, open up on them.", "intent": "OPEN_FIRE", "timing": "on_signal", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "open_fire"},
  {"id": "r6v5_011", "text": "Put rounds on the main door, they're about to swing.", "intent": "OPEN_FIRE", "timing": "now", "reference": "none",
   "target": {"object": "door", "qualifier": "main", "zone": null, "direction": null, "unknown_modifier": false}, "kind": "open_fire"},
  {"id": "r6v5_012", "text": "Shoot straight ahead, he's wide swinging you!", "intent": "OPEN_FIRE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": "forward", "unknown_modifier": false}, "kind": "open_fire"},
  {"id": "r6v5_013", "text": "Shoot through that soft wall, I've got him pinged.", "intent": "OPEN_FIRE", "timing": "now", "reference": "this",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "open_fire"},
  {"id": "r6v5_014", "text": "You're free to shoot, don't wait on me.", "intent": "OPEN_FIRE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "open_fire"},
  {"id": "r6v5_015", "text": "Shoot him, shoot him, he's reloading!", "intent": "OPEN_FIRE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "open_fire"},

  {"id": "r6v5_016", "text": "Don't shoot, that's me on the rappel.", "intent": "HOLD_FIRE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "hold_fire"},
  {"id": "r6v5_017", "text": "Do not fire yet, you'll give away our position.", "intent": "HOLD_FIRE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "hold_fire"},
  {"id": "r6v5_018", "text": "Hold your shots until he walks into the open.", "intent": "HOLD_FIRE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "hold_fire"},
  {"id": "r6v5_019", "text": "Stop shooting at the east door, I'm about to walk through it.", "intent": "HOLD_FIRE", "timing": "now", "reference": "none",
   "target": {"object": "door", "qualifier": "east", "zone": null, "direction": null, "unknown_modifier": false}, "kind": "hold_fire"},
  {"id": "r6v5_020", "text": "Cease fire, cease fire, he's already dead.", "intent": "HOLD_FIRE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "hold_fire"},
  {"id": "r6v5_021", "text": "Quit shooting but keep moving with me.", "intent": "HOLD_FIRE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "hold_fire"},
  {"id": "r6v5_022", "text": "Don't shoot to your right, that's me rotating.", "intent": "HOLD_FIRE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": "right", "unknown_modifier": false}, "kind": "hold_fire"},
  {"id": "r6v5_023", "text": "Weapons tight, nobody shoots while I get my drone in.", "intent": "HOLD_FIRE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "hold_fire"},

  {"id": "r6v5_024", "text": "Attack through main, push in and clear the site.", "intent": "ENTRY", "timing": "now", "reference": "none",
   "target": {"object": "door", "qualifier": "main", "zone": null, "direction": null, "unknown_modifier": false}, "kind": "boundary"},
  {"id": "r6v5_025", "text": "Hit them through this wall, pop your charge on it.", "intent": "BREACH", "timing": "now", "reference": "this",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "boundary"},
  {"id": "r6v5_026", "text": "Take him out with a nade, cook it and send it.", "intent": "FRAG", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "boundary"},
  {"id": "r6v5_027", "text": "Stop, stop everything, hold up a second.", "intent": "WAIT", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "boundary"},
  {"id": "r6v5_028", "text": "Stop fighting and back up, disengage, disengage.", "intent": "FALL_BACK", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "boundary"},
  {"id": "r6v5_029", "text": "Cover me while I plant, gun up on anyone who peeks.", "intent": "COVER_ME", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "boundary"},
  {"id": "r6v5_030", "text": "Keep your crosshair on the north door, be ready to fire.", "intent": "HOLD_ANGLE", "timing": "now", "reference": "none",
   "target": {"object": "door", "qualifier": "north", "zone": null, "direction": null, "unknown_modifier": false}, "kind": "boundary"},
  {"id": "r6v5_031", "text": "You're getting lit up, get down behind something!", "intent": "TAKE_COVER", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "boundary"},
  {"id": "r6v5_032", "text": "Go, go, go, execute right now!", "intent": "GO_NOW", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "boundary"},
  {"id": "r6v5_033", "text": "Hold where you are, don't move an inch.", "intent": "HOLD_POSITION", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "boundary"},

  {"id": "r6v5_034", "text": "Move forward a few meters, I need you closer.", "intent": "MOVE_TO", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": "forward", "unknown_modifier": false}, "kind": "direction"},
  {"id": "r6v5_035", "text": "Look up and hold the ceiling, they're playing vertical.", "intent": "HOLD_ANGLE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": "up", "unknown_modifier": false}, "kind": "direction"},
  {"id": "r6v5_036", "text": "Wrap around to the right and catch them from the side.", "intent": "FLANK", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": "right", "unknown_modifier": false}, "kind": "direction"},
  {"id": "r6v5_037", "text": "Smoke off the left for me, I need to cross.", "intent": "SMOKE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": "left", "unknown_modifier": false}, "kind": "direction"},
  {"id": "r6v5_038", "text": "Open the door on your left, quietly, don't walk through.", "intent": "OPEN", "timing": "now", "reference": "none",
   "target": {"object": "door", "qualifier": null, "zone": null, "direction": "left", "unknown_modifier": false}, "kind": "direction"},
  {"id": "r6v5_039", "text": "Toss a nade behind the sofa, someone's tucked in.", "intent": "FRAG", "timing": "now", "reference": "none",
   "target": {"object": "sofa", "qualifier": null, "zone": null, "direction": "back", "unknown_modifier": false}, "kind": "direction"},
  {"id": "r6v5_040", "text": "Rappel to the window above you and hold on the rope.", "intent": "RAPPEL", "timing": "now", "reference": "none",
   "target": {"object": "window", "qualifier": null, "zone": null, "direction": "up", "unknown_modifier": false}, "kind": "direction"},
  {"id": "r6v5_041", "text": "Head down the white stairs and get on site.", "intent": "MOVE_TO", "timing": "now", "reference": "none",
   "target": {"object": "stairs", "qualifier": "white", "zone": null, "direction": "down", "unknown_modifier": false}, "kind": "direction"},
  {"id": "r6v5_042", "text": "Turn around and hold your six, a roamer is coming.", "intent": "HOLD_ANGLE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": "back", "unknown_modifier": false}, "kind": "direction"},
  {"id": "r6v5_043", "text": "Throw your flash at nine o'clock, I'll swing off it.", "intent": "FLASH", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": "left", "unknown_modifier": false}, "kind": "direction"},
  {"id": "r6v5_044", "text": "I'm going in from above, you breach from below.", "intent": "BREACH", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": "down", "unknown_modifier": false}, "kind": "direction"},
  {"id": "r6v5_045", "text": "I'll rotate left, you head right and meet me on site.", "intent": "MOVE_TO", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": "right", "unknown_modifier": false}, "kind": "direction"},

  {"id": "r6v5_046", "text": "One peeking the left window, he's got an ACOG.", "intent": "NONE", "timing": "now", "reference": "none",
   "target": {"object": "window", "qualifier": null, "zone": null, "direction": "left", "unknown_modifier": false}, "kind": "callout"},
  {"id": "r6v5_047", "text": "He's above us, I can hear him walking around.", "intent": "NONE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": "up", "unknown_modifier": false}, "kind": "callout"},
  {"id": "r6v5_048", "text": "Two of them coming down the yellow stairs.", "intent": "NONE", "timing": "now", "reference": "none",
   "target": {"object": "stairs", "qualifier": "yellow", "zone": null, "direction": "down", "unknown_modifier": false}, "kind": "callout"},
  {"id": "r6v5_049", "text": "Roamer on your six, he's really close.", "intent": "NONE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": "back", "unknown_modifier": false}, "kind": "callout"},

  {"id": "r6v5_050", "text": "Go ahead and plant, I've got the flank watched.", "intent": "PLANT", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "other_sense"},
  {"id": "r6v5_051", "text": "Only two left, we can win this round.", "intent": "NONE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "other_sense"},
  {"id": "r6v5_052", "text": "Yeah, you're right, that was my bad.", "intent": "NONE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "other_sense"},
  {"id": "r6v5_053", "text": "Watch the back door, they'll rotate through it.", "intent": "HOLD_ANGLE", "timing": "now", "reference": "none",
   "target": {"object": "door", "qualifier": null, "zone": null, "direction": null, "unknown_modifier": true}, "kind": "other_sense"},

  {"id": "r6v5_054", "text": "No, don't attack them, that's not the play.", "intent": "NONE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "negated"},
  {"id": "r6v5_055", "text": "Do not open up on them, keep your gun quiet.", "intent": "HOLD_FIRE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "negated"},
  {"id": "r6v5_056", "text": "Cancel the attack, hold on, we're not ready.", "intent": "WAIT", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "negated"},

  {"id": "r6v5_057", "text": "Honestly, their roamers are way better than ours.", "intent": "NONE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "chatter"},
  {"id": "r6v5_058", "text": "What's your ping like, are you lagging?", "intent": "NONE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "chatter"},
  {"id": "r6v5_059", "text": "Reload and swap to your shotgun before the next push.", "intent": "NONE", "timing": "now", "reference": "none",
   "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "chatter"}
]
