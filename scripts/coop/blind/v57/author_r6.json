[
{"id": "r6v57_000", "text": "Switch weapons.", "intent": "SWITCH_WEAPON", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "switchweapon"},
{"id": "r6v57_001", "text": "Hop out of the car, we're pushing in on foot.", "intent": "GET_OUT", "timing": "now", "reference": "none", "target": {"object": "car", "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "getout"},
{"id": "r6v57_002", "text": "Reload.", "intent": "RELOAD", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "reload"},
{"id": "r6v57_003", "text": "Go grab some ammo, you're nearly dry.", "intent": "MOVE_TO", "timing": "now", "reference": "none", "target": {"object": "ammo", "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "pickup"},
{"id": "r6v57_004", "text": "Cover me while I reload, I'm empty.", "intent": "COVER_ME", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "boundary"},
{"id": "r6v57_005", "text": "Get behind the truck, there's a Glaz holding the long sightline.", "intent": "TAKE_COVER", "timing": "now", "reference": "none", "target": {"object": "car", "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "cover"},
{"id": "r6v57_006", "text": "You're out of ammo, pull your sidearm.", "intent": "SWITCH_WEAPON", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "switchweapon"},
{"id": "r6v57_007", "text": "Jump down here.", "intent": "JUMP", "timing": "now", "reference": "this", "target": {"object": null, "qualifier": null, "zone": null, "direction": "down", "unknown_modifier": false}, "kind": "jumpdown"},
{"id": "r6v57_008", "text": "Get out.", "intent": "GET_OUT", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "getout"},
{"id": "r6v57_009", "text": "You're on like three bullets, swap mags.", "intent": "RELOAD", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "reload"},
{"id": "r6v57_010", "text": "Get out of there, Ying's about to flash you!", "intent": "FALL_BACK", "timing": "now", "reference": "this", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "boundary"},
{"id": "r6v57_011", "text": "Primary's dry, go to your secondary.", "intent": "SWITCH_WEAPON", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "switchweapon"},
{"id": "r6v57_012", "text": "Pick up that shotgun, it's way better for anchoring.", "intent": "MOVE_TO", "timing": "now", "reference": "this", "target": {"object": "weapon", "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "pickup"},
{"id": "r6v57_013", "text": "He's reloading, he's reloading!", "intent": "NONE", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "boundary"},
{"id": "r6v57_014", "text": "Bail out of the truck, it's about to get blown up.", "intent": "GET_OUT", "timing": "now", "reference": "none", "target": {"object": "car", "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "getout"},
{"id": "r6v57_015", "text": "Get the shotgun out, it's all close quarters from now on.", "intent": "SWITCH_WEAPON", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "switchweapon"},
{"id": "r6v57_016", "text": "Hide right here till their drone's gone.", "intent": "TAKE_COVER", "timing": "now", "reference": "this", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "cover"},
{"id": "r6v57_017", "text": "Top off before we push.", "intent": "RELOAD", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "reload"},
{"id": "r6v57_018", "text": "Grab your shotgun, they're coming through the hatch.", "intent": "SWITCH_WEAPON", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "boundary"},
{"id": "r6v57_019", "text": "On my call, swap to your pistol.", "intent": "SWITCH_WEAPON", "timing": "on_signal", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "switchweapon"},
{"id": "r6v57_020", "text": "There's a rifle on my pin, go get it.", "intent": "MOVE_TO", "timing": "now", "reference": "pin", "target": {"object": "weapon", "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "pickup"},
{"id": "r6v57_021", "text": "Get out, get out, they're lighting up the car!", "intent": "GET_OUT", "timing": "now", "reference": "none", "target": {"object": "car", "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "getout"},
{"id": "r6v57_022", "text": "Just shoot, no time to swap guns!", "intent": "OPEN_FIRE", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "boundary"},
{"id": "r6v57_023", "text": "Drop down through that hatch, I'll watch the stairs.", "intent": "JUMP", "timing": "now", "reference": "this", "target": {"object": null, "qualifier": null, "zone": null, "direction": "down", "unknown_modifier": false}, "kind": "jumpdown"},
{"id": "r6v57_024", "text": "Get a fresh mag in while they're rotating.", "intent": "RELOAD", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "reload"},
{"id": "r6v57_025", "text": "Mag's empty and there's no time, just swap to the pistol.", "intent": "SWITCH_WEAPON", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "switchweapon"},
{"id": "r6v57_026", "text": "Find ammo upstairs before we hit site.", "intent": "MOVE_TO", "timing": "now", "reference": "none", "target": {"object": "ammo", "qualifier": null, "zone": "up", "direction": null, "unknown_modifier": false}, "kind": "pickup"},
{"id": "r6v57_027", "text": "Go find a shotgun, your SMG isn't cutting it.", "intent": "MOVE_TO", "timing": "now", "reference": "none", "target": {"object": "weapon", "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "boundary"},
{"id": "r6v57_028", "text": "Jump out, we walk the rest of the way.", "intent": "GET_OUT", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "getout"},
{"id": "r6v57_029", "text": "Find cover over there behind the sofa, Ash is spraying through the wall.", "intent": "TAKE_COVER", "timing": "now", "reference": "this", "target": {"object": "sofa", "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "cover"},
{"id": "r6v57_030", "text": "Switch back to your rifle, Smoke's dead.", "intent": "SWITCH_WEAPON", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "switchweapon"},
{"id": "r6v57_031", "text": "Throw a new mag in, quick, they're about to swing.", "intent": "RELOAD", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "reload"},
{"id": "r6v57_032", "text": "Jump out the south window.", "intent": "VAULT_WINDOW", "timing": "now", "reference": "none", "target": {"object": "window", "qualifier": "south", "zone": null, "direction": null, "unknown_modifier": false}, "kind": "boundary"},
{"id": "r6v57_033", "text": "Jump off the balcony down to the first floor, it's faster than the stairs.", "intent": "JUMP", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": "floor_1", "direction": "down", "unknown_modifier": false}, "kind": "jumpdown"},
{"id": "r6v57_034", "text": "Restock at the ammo crate in the basement.", "intent": "MOVE_TO", "timing": "now", "reference": "none", "target": {"object": "ammo", "qualifier": null, "zone": "basement", "direction": null, "unknown_modifier": false}, "kind": "pickup"},
{"id": "r6v57_035", "text": "Next weapon.", "intent": "SWITCH_WEAPON", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "switchweapon"},
{"id": "r6v57_036", "text": "Leave the vehicle when I say go, not before.", "intent": "GET_OUT", "timing": "on_signal", "reference": "none", "target": {"object": "car", "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "getout"},
{"id": "r6v57_037", "text": "Change mags, I've got the door covered.", "intent": "RELOAD", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "reload"},
{"id": "r6v57_038", "text": "Spare ammo's on the second floor if you need it.", "intent": "NONE", "timing": "now", "reference": "none", "target": {"object": "ammo", "qualifier": null, "zone": "floor_2", "direction": null, "unknown_modifier": false}, "kind": "boundary"},
{"id": "r6v57_039", "text": "Go back to your primary, the Jager's down.", "intent": "SWITCH_WEAPON", "timing": "now", "reference": "none", "target": {"object": null, "qualifier": null, "zone": null, "direction": null, "unknown_modifier": false}, "kind": "switchweapon"}
