# local environment and build output
.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# model weights: over GitHub's 100 MB file limit (9 x .safetensors + 7 x .onnx, about 10 GB); kept outside git
*.safetensors
*.onnx
# the decoder of the chain (cpp/coop_intent/README.md, "Lines with several orders or with a context"): a 1 GB file made
# by scripts/coop/stt/gguf_v54.py from the author's base model and the adapter
*.gguf

# ONNX Runtime release, downloaded per platform (cpp/coop_intent/README.md)
cpp/coop_intent/third_party/onnxruntime-*
# sherpa-onnx's C API, copied per platform from the Python package of the same version (cpp/coop_intent/README.md)
cpp/coop_intent/third_party/sherpa-onnx-*

# speech chain (scripts/coop/stt/README.md): synthesized test audio, downloaded speech models and the tools' environment are
# regenerated or downloaded per machine; the transcripts, lists, scripts and results next to them are in git
scripts/coop/stt/wav_*/
scripts/coop/stt/models/
scripts/coop/stt/tts/
scripts/coop/stt/tts_demo_*/
scripts/coop/stt/models_out/
scripts/coop/stt/venv/

# bot voices trained from heavy-model renders (scripts/coop/voice): environments, model downloads, rendered corpora,
# training runs and exported voices are regenerated per machine; the scripts are in git
scripts/coop/voice/work/

# stderr of the training processes (library warnings); their summaries are in build_*.log
scripts/coop/stt/*.log.err
# stdout and stderr of the voicing tools, one pair per voice and recognizer; the summary of the run is in voices_*.log
scripts/coop/stt/*.log.*.out
scripts/coop/stt/*.log.*.err
# llama.cpp's server talking to itself while gguf_v54.py measures a GGUF; the measurements are in gguf54_*.json
scripts/coop/stt/*.server.log

# the distillation study (scripts/coop/stt/distill_v54.py): the fold teachers' probabilities on their training lines
# (26 MB each) and the students' pooled vectors are regenerated by the scripts; the students' out-of-fold files,
# the scores and the logs next to them are in git
scripts/coop/stt/kd54_teacher_s*.json
scripts/coop/stt/kd54_emb_*.npz

# the decider study's C++ check (scripts/coop/decider/cpp): its CMake build folder, with llama.cpp's DLLs copied in
scripts/coop/decider/cpp/build/
# CMake's output of a local build of coop_intent, kept by hand next to it
cpp/coop_intent/build_*.log
cpp/coop_intent/build_*.err
