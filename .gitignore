# local environment and build output
.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# model weights: over GitHub's 100 MB file limit (9 x .safetensors + 7 x .onnx, about 10 GB); kept outside git
*.safetensors
*.onnx

# ONNX Runtime release, downloaded per platform (cpp/coop_intent/README.md)
cpp/coop_intent/third_party/onnxruntime-*
# sherpa-onnx's C API, copied per platform from the Python package of the same version (cpp/coop_intent/README.md)
cpp/coop_intent/third_party/sherpa-onnx-*

# speech chain (scripts/coop/stt/README.md): synthesized test audio, downloaded speech models and the tools' environment are
# regenerated or downloaded per machine; the transcripts, lists, scripts and results next to them are in git
scripts/coop/stt/wav_*/
scripts/coop/stt/models/
scripts/coop/stt/tts/
scripts/coop/stt/models_out/
scripts/coop/stt/venv/

# stderr of the training processes (library warnings); their summaries are in build_*.log
scripts/coop/stt/*.log.err
